#!/bin/sh
# fifi-agent — an offline, on-device AI agent for FiFi OS.
#
# Unlike `fifi-ai` (a plain chat), this drives the local model in a loop where
# it can RUN shell commands to actually operate the computer, read the output,
# and continue — the same shape as Claude Code, but 100% offline on this PC.
#
# SAFETY: the local model is small and makes mistakes (it once claimed to
# "update the kernel to 5.4.1", a version that would have bricked the box).
# So state-changing commands require your confirmation, and a few catastrophic
# patterns are hard-blocked. Read-only inspection commands run automatically.
#
# Usage:  fifi-agent            (interactive)
#         fifi-agent "goal"     (start with a goal)

AI_DIR=/fifi-data/ai
CONF="$AI_DIR/model.conf"
MAX_STEPS=12                  # stop runaway loops

CLI=llama-cli
command -v "$CLI" >/dev/null 2>&1 || CLI=/usr/bin/llama-cli
if ! command -v "$CLI" >/dev/null 2>&1 && [ ! -x "$CLI" ]; then
    echo "The AI runtime (llama-cli) is not installed in this build."; exit 1
fi
if [ ! -f "$CONF" ]; then
    echo "No local AI model is installed. Add one with:  fifi-ai-install"; exit 0
fi
NAME=$(sed -n 's/^name=//p' "$CONF")
MFILE=$(sed -n 's/^file=//p' "$CONF")
MODEL="$AI_DIR/$MFILE"
[ -n "$NAME" ] || NAME="local model"
if [ ! -f "$MODEL" ]; then
    echo "The model file is missing: $MODEL  (re-add with fifi-ai-install)"; exit 1
fi

THREADS=$(nproc 2>/dev/null || echo 4); [ "$THREADS" -gt 16 ] && THREADS=16

# Safety mode: ask = confirm every state-changing command (default, safest).
#              auto = auto-run read-only, confirm only writes/destructive.
# Read /fifi-data/ai/agent.conf line "mode=ask|auto" if present.
MODE=ask
[ -f "$AI_DIR/agent.conf" ] && MODE=$(sed -n 's/^mode=//p' "$AI_DIR/agent.conf" | head -1)
[ "$MODE" = auto ] || MODE=ask

SYS='You are FiFi Assistant, an AI that operates this FiFi Linux PC to help the user.
You work in a loop: think briefly, then either run ONE shell command or finish.

To run a command, output exactly one line and nothing else:
RUN: <exact shell command>
You will then receive its result on a line starting with OUTPUT:. Use it, then continue.

When the task is done (or no command is needed), output exactly one line:
DONE: <short answer/summary for the user>

Rules:
- Exactly ONE RUN: or DONE: per reply, on its own line. No extra prose around it.
- You MUST run the commands YOURSELF with RUN:. NEVER tell the user to run a
  command themselves, and never say you cannot access the system - you CAN, via
  RUN:. Telling the user what to type is wrong; emit RUN: instead.
- Inspect with safe read-only commands before changing anything.
- NEVER invent command output; if you have not run a command you do not know its result.
- This is FiFi OS, a custom minimal Linux. There is NO pacman/apt/dnf; never use a package manager.
- Do not attempt to update, downgrade, or reinstall the kernel or bootloader.

Example of the REQUIRED format:
User: what CPU does this machine have?
Assistant: RUN: lscpu | grep "Model name"
OUTPUT: Model name: Intel(R) Core(TM) i9-14900HX
Assistant: DONE: This machine has an Intel Core i9-14900HX.

Another example:
User: scan my system for all hardware
Assistant: RUN: lspci
OUTPUT: (a list of PCI devices)
Assistant: RUN: lscpu
OUTPUT: (cpu details)
Assistant: DONE: Here is your hardware: <summary of what the commands showed>.'

# ── classify a command: prints "ro" (read-only), "mut" (mutating), or "danger"
classify() {
    c=$1
    case "$c" in
        *"rm -rf /"*|*"rm -fr /"*|*mkfs*|*wipefs*|*" dd "*of=/dev/*|*">/dev/sd"*|\
        *">/dev/nvme"*|*fdisk*|*sgdisk*|*parted*|*":(){"*|*reboot*|*poweroff*|*shutdown*|\
        *halt*|*/fifi-data/boot*|*switch_root*|*chroot*)
            echo danger; return;;
    esac
    # Read-only allowlist: the first token (and simple pipelines of them) only inspect.
    first=$(printf '%s' "$c" | sed 's/^ *//' | cut -d' ' -f1)
    case "$first" in
        ls|cat|head|tail|df|du|free|ps|uname|uptime|ip|ifconfig|grep|egrep|fgrep|\
        stat|echo|pwd|whoami|id|date|lsblk|lsusb|lspci|lscpu|lshw|lsmod|lsof|\
        sensors|vulkaninfo|glxinfo|eglinfo|dmidecode|getconf|\
        wc|sort|uniq|readlink|realpath|\
        sha1sum|md5sum|ss|netstat|env|printenv|which|type|file|hostname|nproc|\
        dmesg|journalctl|top|vmstat|cut|awk|sed|find|test|xxd|od|strings|ldd)
            # sed/find can still mutate; flag those specific forms as mutating.
            case "$c" in *"sed -i"*|*" -delete"*|*"-exec"*|*">"*|*">>"*) echo mut; return;; esac
            echo ro; return;;
    esac
    echo mut
}

run_cmd() {
    cmd=$1
    kind=$(classify "$cmd")
    # run_cmd is invoked inside $(...): stdout is captured for the transcript,
    # so all user-facing prompt text MUST go to stderr to reach the terminal.
    if [ "$kind" = danger ]; then
        echo >&2
        echo "  !! DANGEROUS command proposed by the AI:" >&2
        echo "     $cmd" >&2
        printf "     This could damage the system or data. Type EXACTLY 'yes do it' to run: " >&2
        read ans
        [ "$ans" = "yes do it" ] || { echo "  (skipped)" >&2; echo "OUTPUT: [refused by user - command not run]"; return; }
    elif [ "$kind" = mut ] && [ "$MODE" = ask ]; then
        # Only state-changing commands need confirmation. Read-only inspection
        # commands (the allowlist above) always run without a prompt, so a task
        # like "scan my hardware" completes on its own.
        echo >&2
        echo "  AI wants to run: $cmd" >&2
        printf "  Run it? [y/N]: " >&2
        read ans
        case "$ans" in y|Y|yes|YES) ;; *) echo "  (skipped)" >&2; echo "OUTPUT: [declined by user - command not run]"; return;; esac
    else
        echo "  running: $cmd" >&2
    fi
    # execute (read-only always; mutating after the confirm above)
    out=$(sh -c "$cmd" 2>&1)
    # truncate to keep the model's context small
    printf 'OUTPUT: %s' "$(printf '%s' "$out" | head -c 1500)"
    echo
}

# Extract the first RUN:/DONE: directive from a model reply. Tolerant of the
# 14B model's common deviations: leading spaces, a "> " prefix, markdown bold
# (**RUN:**), or the directive wrapped in backticks. Normalizes to a bare
# "RUN: ..." / "DONE: ..." line so the loop below matches it.
extract() {
    printf '%s' "$1" \
    | sed -E 's/^[[:space:]>*`]*//; s/\*\*//g' \
    | grep -m1 -E '^(RUN|DONE):' \
    | sed -E 's/`+[[:space:]]*$//'
}

# Prefer the resident llama-server (model stays warm -> fast turns); fall back to
# spawning llama-cli per turn if the server is unavailable.
SERVER=$(fifi-ai-serve 2>/dev/null | grep '^http' | head -1)

# JSON-encode stdin into a quoted string (escapes \, ", and control chars).
json_encode() { awk 'BEGIN{RS="\1";ORS="";printf "\""} {gsub(/\\/,"\\\\");gsub(/"/,"\\\"");gsub(/\t/,"\\t");gsub(/\r/,"");gsub(/\n/,"\\n");print} END{printf "\""}'; }

server_turn() {
    # $1 = prompt. POST to llama-server /completion, print the model reply.
    prompt=$(printf '%s' "$1" | json_encode)
    body="{\"prompt\":$prompt,\"n_predict\":200,\"temperature\":0.3,\"cache_prompt\":true,\"stop\":[\"\\nUser:\",\"\\nOUTPUT:\"]}"
    resp=$(curl -s -m 180 "$SERVER/completion" -H 'Content-Type: application/json' -d "$body" 2>/dev/null)
    # Pull the "content" field and unescape it (awk state machine, no jq needed).
    printf '%s' "$resp" | awk '
      { s=s $0 }
      END{
        i=index(s,"\"content\":\""); if(!i){exit}
        r=substr(s,i+11); out=""; n=length(r)
        for(j=1;j<=n;j++){c=substr(r,j,1)
          if(c=="\\"){d=substr(r,j+1,1);j++
            if(d=="n")out=out"\n"; else if(d=="t")out=out"\t"; else if(d=="\"")out=out"\""; else if(d=="\\")out=out"\\"; else out=out d}
          else if(c=="\""){break}
          else out=out c}
        printf "%s", out
      }'
}

agent_turn() {
    # $1 = full transcript text; prints the model's cleaned reply.
    if [ -n "$SERVER" ]; then
        server_turn "$SYS
$1"
        return
    fi
    # Fallback: spawn llama-cli for one turn (-st) then exit. Strip its UI chrome
    # (banner, ASCII logo, prompt marker, perf line) so only the reply remains.
    "$CLI" -m "$MODEL" -st --simple-io --no-display-prompt --no-warmup \
        -t "$THREADS" -c 4096 -n 200 -sys "$SYS" -p "$1" </dev/null 2>/dev/null \
    | grep -avE 'Loading model|available commands|^  /(exit|regen|clear|read|glob)|^modalities|^> $|^\[ Prompt:|^Exiting|^build:|^main:' \
    | sed '/[▄█▀]/d'
}

clear
echo "FiFi Agent  -  $NAME  (offline, can operate this PC)"
echo "Safety mode: $MODE   (edit $AI_DIR/agent.conf: mode=ask|auto)"
echo "Type a goal. Ctrl+C or /exit to quit."
echo

TRANSCRIPT=""
GOAL="$*"
while :; do
    if [ -z "$GOAL" ]; then
        printf "you> "; read GOAL || break
        [ "$GOAL" = "/exit" ] && break
        [ -z "$GOAL" ] && continue
    fi
    TRANSCRIPT="${TRANSCRIPT}User: ${GOAL}
"
    GOAL=""
    step=0
    while [ "$step" -lt "$MAX_STEPS" ]; do
        step=$((step+1))
        reply=$(agent_turn "${TRANSCRIPT}Assistant:")
        directive=$(extract "$reply")
        if [ -z "$directive" ]; then
            # no directive - treat the whole reply as the final answer
            echo "FiFi> $(printf '%s' "$reply" | head -c 1200)"
            TRANSCRIPT="${TRANSCRIPT}Assistant: ${reply}
"
            break
        fi
        case "$directive" in
            DONE:*)
                echo "FiFi> $(printf '%s' "$directive" | sed 's/^DONE: *//')"
                TRANSCRIPT="${TRANSCRIPT}Assistant: ${directive}
"
                break;;
            RUN:*)
                cmd=$(printf '%s' "$directive" | sed 's/^RUN: *//')
                obs=$(run_cmd "$cmd")
                echo "  $obs" | head -c 400; echo
                TRANSCRIPT="${TRANSCRIPT}Assistant: RUN: ${cmd}
${obs}
"
                ;;
        esac
        if [ "$step" -ge "$MAX_STEPS" ]; then
            echo "FiFi> (stopped after $MAX_STEPS steps - ask me to continue if needed)"
        fi
    done
    echo
done
