#!/bin/sh
# fifi-run — the single, unified app launcher for FiFi OS.
#
# Every app (App Store downloads, desktop icons, bundled apps) launches through
# here so they all open and run the same way against the shared FiFi runtime
# (/fifi-data/runtime: libs + xkb + fontconfig). AppImages are auto-extracted
# once (no FUSE on the box) and cached next to the .AppImage as <name>.d/.
#
# Usage: fifi-run <path-to-.AppImage | path-to-executable> [args...]
set -e

# glibc provides C.UTF-8 without a generated locale archive. The minimal FiFi
# image intentionally omits that multi-megabyte archive, so do not advertise an
# unavailable en_US locale to browsers and office applications.
export LANG=C.UTF-8 LC_ALL=C.UTF-8

RT=/fifi-data/runtime
BROWSER=/fifi-data/browser
target="$1"
[ -n "$target" ] || { echo "usage: fifi-run <app> [args...]" >&2; exit 2; }
shift 2>/dev/null || true

# --- shared runtime environment (identical for every app) ---------------------
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
export PIPEWIRE_RUNTIME_DIR="${PIPEWIRE_RUNTIME_DIR:-/tmp}"
export PULSE_SERVER="${PULSE_SERVER:-unix:/tmp/pulse/native}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
# NOTE: do NOT set XDG_CURRENT_DESKTOP=GNOME to try to get Firefox's window
# buttons — it makes LibreWolf hang waiting on GNOME/portal services that don't
# exist here (verified: browser never appears). LibreWolf draws its own titlebar
# via CSD; close with Ctrl+Q / its menu / Alt+F4.
export XKB_CONFIG_ROOT="$RT/share/X11/xkb"
export FONTCONFIG_PATH="$RT/etc/fonts"
export XCURSOR_PATH="$RT/share/icons:/usr/share/icons"
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
export XDG_DATA_DIRS="$RT/share:$BROWSER/sysroot/usr/share:/usr/share"
export GDK_PIXBUF_MODULE_FILE="${GDK_PIXBUF_MODULE_FILE:-/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache}"
export LD_LIBRARY_PATH="$RT/lib:$BROWSER/squashfs-root:$BROWSER/sysroot/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Keep accessibility bridges optional while sharing FiFi's local user bus.
export NO_AT_BRIDGE=1 GTK_A11Y=none GNOME_ACCESSIBILITY=0 QT_ACCESSIBILITY=0
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/tmp/fifi-session-bus}"
# software rendering (no GPU stack on the box yet)
export LIBGL_ALWAYS_SOFTWARE=1
# steer every toolkit to Wayland
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
# Bitwarden's AppImage wrapper defaults to --ozone-platform=x11 (to dodge an
# Electron 39 Wayland+hardware-accel crash) UNLESS USE_X11=false. On the box we
# render in software, so that crash doesn't apply — and forcing X11 routed
# Bitwarden through XWayland, which opened it full-screen and turned it
# transparent when resized smaller. Opt back into Wayland so it's a normal,
# resizable FiFi window. Harmless to apps that don't read USE_X11.
export USE_X11=false
export APPIMAGE_EXTRACT_AND_RUN=1

# Provide xdg-open: apps shell out to it to open a URL/file in the user's browser
# or default handler, and the box ships none (LibreOffice's "Check for Updates ->
# Download..." ran `xdg-open <url>` -> "xdg-open: not found" -> the button did
# nothing). This shim routes http(s)/ftp URLs and .html files to LibreWolf and
# everything else to the file browser, both through this same launcher. Recreated
# each launch (in tmpfs) and put first on PATH so every app inherits it.
if [ ! -x /tmp/fifi-xdg/xdg-open ]; then
    mkdir -p /tmp/fifi-xdg 2>/dev/null || true
    cat > /tmp/fifi-xdg/xdg-open <<'XDGEOF'
#!/bin/sh
t="$1"
case "$t" in
    http://*|https://*|ftp://*|*.htm|*.html)
        exec /usr/share/fifi/fifi-run /fifi-data/apps/LibreWolf.AppImage "$t" ;;
    *)
        exec /usr/share/fifi/fifi-run /fifi-data/apps/LibreWolf.AppImage "$t" ;;
esac
XDGEOF
    chmod +x /tmp/fifi-xdg/xdg-open 2>/dev/null || true
fi
export PATH="/tmp/fifi-xdg:${PATH:-/usr/bin:/bin}"

# Start a ROOTLESS XWayland (:0) on demand for apps that only speak X11 (e.g.
# LibreOffice's "gen" VCL). Rootless = each X11 window becomes its own FiFi
# window with normal decorations and no black X-root border. The compositor's
# built-in X11 window manager (xwm.c) maps + decorates these windows.
# The X client libs, libEGL, and xkbcomp live in the persistent runtime; only
# /usr resets each boot, so xkbcomp is re-seeded there (Xwayland execs it by
# absolute path).
# --- app sandbox -------------------------------------------------------------
# Launch each app in isolated namespaces so a compromised or misbehaving app
# cannot see, signal, or snoop the compositor or the other apps: a fresh PID
# namespace (only its own process tree is visible via /proc), a private IPC
# namespace (no shared System V IPC / shared memory with other apps), a private
# mount namespace (its mount changes don't propagate to the host), and a private
# UTS namespace. App processes then drop to the desktop uid with no_new_privs;
# Firefox/Chromium may create their own user namespaces for their content
# sandboxes. We do not isolate the network namespace because networked apps need
# connectivity. Set FIFI_SANDBOX=0 only for diagnosis.
sandbox_exec() {
    _sandbox_root=0
    if [ "$(id -u)" = 0 ] && [ -x /bin/fifi-user-exec ]; then
        _sandbox_root=1
        set -- /bin/fifi-user-exec "$@"
    fi
    if [ "${FIFI_SANDBOX:-1}" = "1" ] && [ "$_sandbox_root" = 1 ]; then
        # A PID namespace is the strongest isolation but kills the whole namespace
        # the instant its pid 1 exits — fine for apps whose main process stays
        # alive (Electron: _sb_pid=1) but fatal for launchers that fork a child
        # and exit (LibreOffice and current LibreWolf), which would take the real
        # process down with them. Those use the lighter mount/ipc/uts sandbox.
        # If unshare is unavailable/fails, exec returns and we fall through to the
        # plain exec below rather than failing the launch.
        if [ "${_sb_pid:-0}" = "1" ]; then
            exec busybox unshare --mount --uts --ipc --pid --mount-proc -f -- "$@"
        fi
        exec busybox unshare --mount --uts --ipc -- "$@"
    fi
    exec "$@"
}

# Log which shared libraries an executable cannot resolve, so an app that fails
# to start (the usual cause on a minimal system is a missing .so) leaves a clear
# breadcrumb instead of dying silently. Diagnostic ONLY: LD_TRACE_LOADED_OBJECTS
# makes the dynamic loader list libraries and exit WITHOUT running the program,
# guarded by a timeout, and this always returns success so it can never block or
# break a real launch. Any missing library can then be dropped into $RT/lib.
diag_libs() {
    _b="$1"
    [ -x "$_b" ] || return 0
    # grep returning 1 means the executable is healthy (nothing was missing).
    # fifi-run uses set -e, so make that normal result explicit instead of
    # aborting every healthy AppImage immediately before its real launch.
    _miss=$(LD_TRACE_LOADED_OBJECTS=1 timeout 5 "$_b" 2>/dev/null |
        grep "not found" || true)
    {
        echo "[${APP_NAME:-app}] launch: $_b"
        if [ -n "$_miss" ]; then
            echo "  MISSING LIBRARIES (drop these into $RT/lib):"
            echo "$_miss" | sed 's/^/    /'
        fi
    } > /fifi-data/apps/last-launch.log 2>/dev/null || true
    return 0
}

# True if a process whose comm matches $1 is running.
proc_running() {
    for _d in /proc/[0-9]*; do
        [ -r "$_d/comm" ] || continue
        read -r _c < "$_d/comm" 2>/dev/null || continue
        [ "$_c" = "$1" ] && return 0
    done
    return 1
}

ensure_xwayland() {
    # XWayland is spawned and window-managed by the COMPOSITOR itself (rootless,
    # launched with -wm so each X11 window becomes its own decorated FiFi window
    # with no black X-root border; see xwm.c). We only wait for the compositor's
    # window manager to be up: /tmp/xwm.ready implies XWayland is running and
    # accepting clients on :0. (xwm removes the file if XWayland dies.)
    _i=0
    while [ "$_i" -lt 200 ]; do
        [ -e /tmp/xwm.ready ] && [ -S /tmp/.X11-unix/X0 ] && return 0
        sleep 0.05; _i=$((_i + 1))
    done
    return 0   # proceed anyway; the app's own retry loop tolerates a slow start
}

launch_dir() {
    # $1 = extracted squashfs-root dir. Detect Electron/Chromium and add the
    # Wayland/software-rendering flags they need on this box.
    dir="$1"; shift
    # Discord-style "downloader" AppImage: it ships an updater_bootstrap that
    # fetches the real (Electron) app to $HOME/.config on first run, then runs
    # it. Do the download here and launch the fetched binary with Electron flags;
    # the shared libs it needs (NSS, etc.) come from $RT/lib.
    if [ -x "$dir/updater_bootstrap" ] && [ -f "$dir/discord" ]; then
        export HOME=/fifi-data/home
        mkdir -p "$HOME/.config/discord" 2>/dev/null || true
        exe=$(ls -d "$HOME"/.config/discord/app-*/Discord 2>/dev/null | tail -1)
        if [ -z "$exe" ]; then
            chown -R 1000:1000 "$HOME/.config/discord" 2>/dev/null || true
            ( cd "$dir" && LD_LIBRARY_PATH="$dir/usr/lib:$LD_LIBRARY_PATH" \
              /bin/fifi-user-exec ./updater_bootstrap \
              --no-zenity "$HOME/.config/discord" \
              stable https://updates.discord.com/ ) >/tmp/discord-install.log 2>&1 || true
            exe=$(ls -d "$HOME"/.config/discord/app-*/Discord 2>/dev/null | tail -1)
        fi
        if [ -n "$exe" ]; then
            chown -R 1000:1000 "$HOME/.config/discord" 2>/dev/null || true
            export LD_LIBRARY_PATH="$(dirname "$exe"):$LD_LIBRARY_PATH"
            _sb_pid=1   # Electron keeps its main process alive
            sandbox_exec "$exe" --ozone-platform=wayland \
                --disable-gpu --in-process-gpu "$@"
        fi
        echo "fifi-run: Discord bootstrap failed (see /tmp/discord-install.log)" >&2
        exit 1
    fi
    # X11-only apps (LibreOffice): no Wayland backend, so run them under a
    # rootful XWayland presented as a single FiFi window.
    if [ -n "$(ls -d "$dir"/program/soffice "$dir"/opt/*/program/soffice 2>/dev/null)" ]; then
        ensure_xwayland
        export DISPLAY=:0
        # Tell the compositor's X window manager what to title the window (the
        # app name), instead of the raw "Xwayland on :0". Written before the app
        # maps so the WM reads it on the first MapRequest.
        printf '%s' "${APP_NAME:-App}" > /tmp/fifi-x11-title 2>/dev/null || true
        export SAL_USE_VCLPLUGIN=gen           # raw-X11 VCL: one rootful window (gtk3 makes a 2nd)
        # Scrub shared-runtime env that isn't meant for a raw-X11 soffice: an
        # invalid "disabled:" D-Bus address (soffice aborts during first-run
        # before it can even log), the Wayland/Electron toolkit hints, and the
        # a11y-disable vars. This matches the minimal env under which soffice
        # starts cleanly.
        unset GDK_BACKEND QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND MOZ_DISABLE_CONTENT_SANDBOX \
              ELECTRON_OZONE_PLATFORM_HINT ELECTRON_DISABLE_SANDBOX USE_X11 \
              APPIMAGE_EXTRACT_AND_RUN DBUS_SESSION_BUS_ADDRESS \
              GTK_A11Y NO_AT_BRIDGE GNOME_ACCESSIBILITY QT_ACCESSIBILITY
        export APPDIR="$dir"
        # This AppImage's AppRun/oosplash wrapper fails to spawn soffice.bin on
        # this box (it never launches -> the rootful X root stays black), but
        # soffice.bin itself starts fine. So launch it DIRECTLY from its program
        # dir: LibreOffice's own libs load via RPATH ($ORIGIN) and the system
        # libs (cairo, nss) come from the browser sysroot already on
        # LD_LIBRARY_PATH. LibreOffice drops to the desktop uid, but does not use
        # the outer namespace wrapper because that breaks its X11 startup.
        _prog=""
        for _p in "$dir"/opt/*/program "$dir"/program; do
            [ -x "$_p/soffice.bin" ] && { _prog="$_p"; break; }
        done
        if [ -n "$_prog" ]; then
            export LD_LIBRARY_PATH="$_prog:$LD_LIBRARY_PATH"
            cd "$_prog"
            # A COLD (freshly started) XWayland fails its very first X client even
            # after it signals ready via -displayfd; the next client succeeds. So
            # retry soffice: if it dies within a few seconds (the cold-X failure
            # is immediate), relaunch — by then XWayland is warm and it starts.
            # Once a launch survives the probe window, wait on it (it is the
            # persistent office process; fifi-run exits when the user closes it).
            # The cold-X crash is immediate, so a short 4s probe is enough to
            # confirm health — no need to sit through 8s on a good launch.
            # soffice.bin forks and RE-PARENTS itself, so the pid we launch
            # exits within a second or two even on a healthy start. Gating the
            # retry on that pid made the loop think it died and relaunch — the
            # user saw LibreOffice "reappear" several times. Track soffice.bin by
            # NAME instead: healthy once any exists; done (no relaunch) once none.
            _t=0
            while [ "$_t" -lt 5 ]; do
                /bin/fifi-user-exec ./soffice.bin --nologo --norestore "$@" &
                _w=0
                while [ "$_w" -lt 5 ]; do
                    sleep 1; _w=$((_w + 1))
                    pidof soffice.bin >/dev/null 2>&1 && break
                done
                if pidof soffice.bin >/dev/null 2>&1; then
                    while pidof soffice.bin >/dev/null 2>&1; do sleep 2; done
                    exit 0
                fi
                _t=$((_t + 1))
                rm -f "$HOME"/.config/libreoffice/*/.lock 2>/dev/null || true
                sleep 1
            done
            exit 1
        fi
        cd "$dir"
        [ -x "$dir/AppRun" ] &&
            exec /bin/fifi-user-exec "$dir/AppRun" "$@"   # fallback
    fi
    # Archimage/JuNest packages (ivan-hc builds) run a containerized Arch inside
    # proot and refuse to start as root. Give them a fake non-root identity via
    # an unprivileged user namespace, a persistent bound home, and a clean env
    # (the container is self-sufficient; FiFi runtime paths would dangle inside).
    if [ -d "$dir/.local/share/junest" ]; then
        mkdir -p /fifi-data/home /home/fifi 2>/dev/null || true
        chown 1000:1000 /fifi-data/home /home/fifi 2>/dev/null || true
        chmod 0700 /fifi-data/home /home/fifi 2>/dev/null || true
        mountpoint -q /home/fifi 2>/dev/null || \
            mount --bind /fifi-data/home /home/fifi 2>/dev/null || true
        # JuNest replaces /usr, so the host cursor theme is otherwise invisible
        # and resize/drag pointers fall back with a warning. Seed the immutable
        # theme into this extracted, user-owned app root once.
        _junest_icons="$dir/.junest/usr/share/icons"
        if [ -d /usr/share/icons/Adwaita ] &&
           [ ! -e "$_junest_icons/Adwaita/cursors/fleur" ]; then
            [ ! -L "$_junest_icons/Adwaita" ] || rm -f "$_junest_icons/Adwaita"
            mkdir -p "$_junest_icons"
            cp -a /usr/share/icons/Adwaita "$_junest_icons/Adwaita"
            chown -RhP 1000:1000 "$_junest_icons/Adwaita" 2>/dev/null || true
        fi
        unset XDG_DATA_DIRS FONTCONFIG_PATH XKB_CONFIG_ROOT LD_LIBRARY_PATH
        export HOME=/home/fifi USER=fifi LOGNAME=fifi
        exec /bin/fifi-user-exec busybox unshare -r -- "$dir/AppRun" "$@"
    fi
    # Steam (ivan-hc RunImage) ships a full Arch rootfs with a native
    # /usr/bin/steam. Running its AppRun does bwrap DOUBLE-nesting (RunImage
    # bwrap → Steam's own pressure-vessel "sniper" bwrap); in that nested
    # container the steamwebhelper never finished init and the UI stayed a black
    # "not responding" window. Instead run the native steam DIRECTLY via chroot
    # into the rootfs, so Steam's sniper is the ONLY container (single nesting) —
    # this reaches the login screen. Requirements that had to be met:
    #   - a private mount namespace + the rootfs made a real mount point, so
    #     pressure-vessel's bwrap can "make / slave" (bwrap refuses in a bare
    #     chroot: "Failed to make / slave: Invalid argument");
    #   - a session D-Bus (steam-runtime-launcher-service needs one);
    #   - /dev/fd (the steam runtime logger uses bash process substitution;
    #     /init now creates /dev/fd -> /proc/self/fd system-wide);
    #   - libibus (ivan-hc's rootfs omits it, CEF needs it);
    #   - -no-cef-sandbox + -cef-disable-gpu-sandbox (CEF sees namespace-root,
    #     and the GPU process's own sandbox couldn't init);
    #   - SDL_VIDEODRIVER=x11 + no WAYLAND_DISPLAY (SDL3 wayland backend fails on
    #     our compositor and won't fall back; the X11/XWayland path works).
    if [ -d "$dir/rootfs" ] && [ -x "$dir/rootfs/usr/bin/steam" ]; then
        ensure_xwayland
        printf 'Steam' > /tmp/fifi-x11-title 2>/dev/null || true
        mkdir -p /fifi-data/home 2>/dev/null || true
        for _need in libibus-1.0.so.5; do
            if [ ! -e "$dir/rootfs/usr/lib/$_need" ]; then
                _src=$(ls /usr/lib/"$_need"* 2>/dev/null | head -1)
                [ -n "$_src" ] && cp "$_src" "$dir/rootfs/usr/lib/$_need" 2>/dev/null || true
            fi
        done
        cp /etc/resolv.conf "$dir/rootfs/etc/resolv.conf" 2>/dev/null || true
        # Inner launch script (kept in the rootfs; avoids deep nested quoting):
        # bring up a per-session bus, run native Steam, and reap both on exit.
        cat > "$dir/rootfs/fifi-steam-launch.sh" <<'STEOF'
#!/bin/sh
rm -f /tmp/steam-session-bus 2>/dev/null
# A killed updater can leave its pid/FIFO markers behind. Steam otherwise exits
# silently forever on every later launch even though that recorded pid is gone.
if [ -r /root/.steam/steam.pid ]; then
    _steam_pid="$(cat /root/.steam/steam.pid 2>/dev/null)"
    if [ -z "$_steam_pid" ] || ! kill -0 "$_steam_pid" 2>/dev/null; then
        rm -f /root/.steam/steam.pid /root/.steam/starting \
              /root/.steam/steam.pipe /root/.steam/steam.token 2>/dev/null
    fi
fi
dbus-daemon --session --address=unix:path=/tmp/steam-session-bus --nofork --nopidfile &
_steam_dbus_pid=$!
_steam_client_pid=
cleanup_steam_session() {
    [ -z "$_steam_client_pid" ] || kill "$_steam_client_pid" 2>/dev/null || true
    kill "$_steam_dbus_pid" 2>/dev/null || true
    wait "$_steam_dbus_pid" 2>/dev/null || true
    rm -f /tmp/steam-session-bus 2>/dev/null || true
}
trap cleanup_steam_session EXIT HUP INT TERM
sleep 1
if [ -x /root/.local/share/Steam/steam.sh ]; then
    /root/.local/share/Steam/steam.sh \
        -no-cef-sandbox -cef-disable-gpu-sandbox &
else
    /usr/bin/steam -no-cef-sandbox -cef-disable-gpu-sandbox &
fi
_steam_client_pid=$!
wait "$_steam_client_pid"
_steam_rc=$?
exit "$_steam_rc"
STEOF
        chmod +x "$dir/rootfs/fifi-steam-launch.sh"
        # Drop to the desktop identity before creating the container. The user
        # namespace maps host uid 1000 to root only inside this private mount
        # namespace, which keeps chroot/mount available without giving Steam or
        # its runtime host-root privileges.
        exec /bin/fifi-user-exec busybox unshare -r -m -- busybox sh -c '
            R="$1"
            busybox mount --make-rprivate /
            busybox mount --bind "$R" "$R"
            busybox mount --make-rprivate "$R"
            # /dev and /sys contain submounts. A plain bind of either is rejected
            # inside an unprivileged user namespace; recursive binds are valid
            # and keep urandom, input, GPU, sound, and proc-backed /dev/fd alive.
            for d in dev sys tmp; do
                busybox mkdir -p "$R/$d"
                busybox mount --rbind "/$d" "$R/$d" || exit 1
                busybox mount --make-rslave "$R/$d" || exit 1
            done
            busybox mkdir -p "$R/proc" "$R/run"
            busybox mount --rbind /proc "$R/proc" || exit 1
            busybox mount --make-rslave "$R/proc" || exit 1
            busybox mount -t tmpfs -o mode=755,nosuid,nodev tmpfs "$R/run" || exit 1
            busybox mkdir -p "$R/run/user/0"
            busybox chmod 0700 "$R/run/user/0"
            busybox mkdir -p /fifi-data/home "$R/root"
            busybox mount --bind /fifi-data/home "$R/root"
            exec chroot "$R" /usr/bin/env -i \
                HOME=/root USER=root LOGNAME=root \
                DISPLAY=:0 XDG_RUNTIME_DIR=/run/user/0 SDL_VIDEODRIVER=x11 \
                TAR_OPTIONS=--no-same-owner LD_LIBRARY_PATH= \
                PATH=/usr/bin:/usr/local/bin:/bin TERM=xterm \
                DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/steam-session-bus \
                /bin/sh /fifi-steam-launch.sh
        ' _ "$dir/rootfs"
    fi
    # Other RunImage/sharun bundles (non-Steam): run their AppRun directly.
    if [ -d "$dir/rootfs" ] && [ -x "$dir/AppRun" ]; then
        ensure_xwayland
        export DISPLAY=:0
        printf '%s' "${APP_NAME:-App}" > /tmp/fifi-x11-title 2>/dev/null || true
        mkdir -p /fifi-data/home 2>/dev/null || true
        export HOME=/fifi-data/home
        export APPDIR="$dir"; cd "$dir"
        exec /bin/fifi-user-exec "$dir/AppRun" "$@"
    fi
    export LD_LIBRARY_PATH="$dir:$LD_LIBRARY_PATH"
    # Firefox/LibreWolf run as the desktop uid. Their own content sandbox remains
    # enabled and uses the user-namespace support required by the FiFi kernel.
    if [ -e "$dir/librewolf-bin" ] || [ -e "$dir/librewolf" ] || \
       [ -e "$dir/firefox-bin" ]  || [ -e "$dir/firefox" ] || \
       [ -e "$dir/usr/bin/librewolf-bin" ] || [ -e "$dir/usr/bin/librewolf" ] || \
       [ -e "$dir/usr/bin/firefox-bin" ]  || [ -e "$dir/usr/bin/firefox" ]; then
        mkdir -p /fifi-data/home 2>/dev/null || true
        export HOME=/fifi-data/home
        # Give Firefox's integrated (CSD) titlebar the min/max/close buttons. It
        # reads the button set from the GtkSetting gtk-decoration-layout, which
        # GTK loads from settings.ini regardless of desktop environment (unlike
        # XDG_CURRENT_DESKTOP=GNOME, which hangs the browser waiting on GNOME
        # services that don't exist here). Written each launch so it's always current.
        mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0" 2>/dev/null || true
        for _gtkdir in "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"; do
            printf '[Settings]\ngtk-decoration-layout=icon:minimize,maximize,close\n' \
                > "$_gtkdir/settings.ini" 2>/dev/null || true
        done
        # Dedicated persistent profile next to the app, created up front so the
        # first run initializes it in place (an empty -profile dir shows "Profile
        # Missing"; a non-existent one too). --no-remote so it never forwards to
        # a stale instance/lock and silently exit.
        prof="$(dirname "$dir")/profile"
        mkdir -p "$prof" 2>/dev/null || true
        chown -R 1000:1000 "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0" \
            "$prof" 2>/dev/null || true
        # Abrupt power loss or a launcher killed during diagnostics can leave
        # Firefox's zero-byte lock/startup marker behind. With no browser
        # process alive these cannot represent a live profile owner, and keeping
        # them forces an unnecessary troubleshoot-mode prompt on every launch.
        if ! proc_running librewolf && ! proc_running firefox; then
            rm -f "$prof/.parentlock" "$prof/lock" "$prof/.startup-incomplete"
        fi
        # FiFi-managed prefs, rewritten from scratch EVERY launch (not guarded on
        # a marker) so EXISTING profiles created before a fix also get it — an
        # earlier guard on browser.tabs.inTitlebar skipped the whole block for old
        # profiles, so the chrome-font fix never applied on reboot. We isolate our
        # prefs in fifi.js and merge them into user.js each launch.
        #  - inTitlebar: the compositor now grants CLIENT-side decorations, so let
        #    Firefox draw its own integrated titlebar (with tabs + the min/max/close
        #    buttons from gtk-decoration-layout above). Was 0 back when FiFi imposed SSD.
        #  - warnOn*: the quit/close confirmation renders as a transparent, unclosable
        #    dialog on this compositor -> disable the prompts so it closes cleanly.
        #  - font.name.*: pin content generics to bundled fonts.
        #  - legacyUserProfileCustomizations.stylesheets: REQUIRED for userChrome.css.
        #  - startup.page=0: skip the "trouble getting your pages back" restore page.
        {
          printf 'user_pref("browser.tabs.inTitlebar", 1);\n'
          printf 'user_pref("browser.tabs.drawInTitlebar", true);\n'
          # Draw Firefox's OWN symbolic min/max/close glyphs instead of the GTK
          # theme's button assets — the box has no GTK icon theme, so the native
          # path renders the controls as blank grey circles. This gives clean
          # -/[]/x glyphs regardless of theme.
          printf 'user_pref("widget.gtk.non-native-titlebar-buttons.enabled", true);\n'
          printf 'user_pref("browser.warnOnQuit", false);\n'
          printf 'user_pref("browser.warnOnClose", false);\n'
          printf 'user_pref("browser.tabs.warnOnClose", false);\n'
          printf 'user_pref("browser.sessionstore.warnOnQuit", false);\n'
          printf 'user_pref("font.name.sans-serif.x-western", "DejaVu Sans");\n'
          printf 'user_pref("font.name.serif.x-western", "DejaVu Serif");\n'
          printf 'user_pref("font.name.monospace.x-western", "DejaVu Sans Mono");\n'
          printf 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n'
          printf 'user_pref("browser.startup.page", 0);\n'
        } > "$prof/fifi.js"
        # user.js = our prefs + any non-FiFi prefs the profile already had.
        if [ -f "$prof/user.js" ]; then
            # || true: grep exits 1 when it filters out EVERY line (profile had only
            # FiFi prefs); under `set -e` that non-zero would abort fifi-run before
            # the browser ever launches.
            grep -vE 'inTitlebar|drawInTitlebar|non-native-titlebar-buttons|warnOn(Quit|Close)|tabs.warnOnClose|sessionstore.warnOnQuit|font.name.(sans-serif|serif|monospace).x-western|legacyUserProfileCustomizations.stylesheets|browser.startup.page' \
                "$prof/user.js" 2>/dev/null >> "$prof/fifi.js" || true
        fi
        mv "$prof/fifi.js" "$prof/user.js"
        # userChrome.css forces the chrome UI font to a bundled family so tab titles
        # and the URL bar always render. Rewritten each launch so old profiles get it.
        mkdir -p "$prof/chrome" 2>/dev/null || true
        # Force family, a concrete pixel size, AND a dark colour: on this box the
        # chrome inherited a zero/unset font size (glyphs laid out but invisible),
        # so family alone was not enough — size + colour make chrome text render.
        # ALSO draw the min/max/close window-button glyphs ourselves: with no GTK
        # icon theme, Firefox renders the controls as blank grey circles, so we
        # paint explicit -/[]/x glyphs via self-contained SVG data URIs (no theme
        # dependency) and flatten the circular background. Written each launch.
        cat > "$prof/chrome/userChrome.css" <<'CSSEOF'
* { font-family: "DejaVu Sans", sans-serif !important; font-size: 15px !important; color: #101010 !important; }
.titlebar-button {
  -moz-appearance: none !important; appearance: none !important;
  background: transparent !important; border-radius: 0 !important; padding: 0 10px !important;
}
.titlebar-button:hover { background: rgba(0,0,0,0.10) !important; }
.titlebar-close:hover  { background: rgba(232,17,35,0.90) !important; }
.titlebar-button > .toolbarbutton-icon {
  -moz-appearance: none !important; appearance: none !important;
  opacity: 1 !important; width: 16px !important; height: 16px !important;
  -moz-context-properties: fill !important; fill: rgb(20,20,20) !important;
}
.titlebar-min {
  list-style-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16'><path d='M3 8 h10' stroke='rgb(20,20,20)' stroke-width='1.2'/></svg>") !important;
}
.titlebar-max {
  list-style-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16'><rect x='3.5' y='3.5' width='9' height='9' fill='none' stroke='rgb(20,20,20)' stroke-width='1.2'/></svg>") !important;
}
.titlebar-restore {
  list-style-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16'><rect x='3.5' y='5.5' width='7' height='7' fill='none' stroke='rgb(20,20,20)' stroke-width='1.2'/><path d='M5.5 5.5 v-2 h7 v7 h-2' fill='none' stroke='rgb(20,20,20)' stroke-width='1.2'/></svg>") !important;
}
.titlebar-close {
  list-style-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16'><path d='M4 4 L12 12 M12 4 L4 12' stroke='rgb(20,20,20)' stroke-width='1.2'/></svg>") !important;
}
CSSEOF
        export APPDIR="$dir"; cd "$dir"
        # Current LibreWolf daemonizes after AppRun. A private PID namespace
        # would be destroyed with the short-lived launcher, so retain mount,
        # IPC, and UTS isolation here and let Firefox's content sandbox provide
        # per-process isolation inside the browser.
        _sb_pid=0
        sandbox_exec "$dir/AppRun" --no-remote -profile "$prof" "$@"
    fi
    if [ -f "$dir/chrome-sandbox" ] || ls "$dir"/resources/*.asar >/dev/null 2>&1; then
        set -- --ozone-platform=wayland --disable-gpu --in-process-gpu "$@"
        _sb_pid=1   # Electron keeps its main process alive → safe for a PID namespace
    fi
    if [ -x "$dir/AppRun" ]; then export APPDIR="$dir"; cd "$dir"; diag_libs "$dir/AppRun"; sandbox_exec "$dir/AppRun" "$@"; fi
    # fallback: an executable named like the dir's parent
    b=$(ls "$dir" 2>/dev/null | while read f; do [ -x "$dir/$f" ] && [ -f "$dir/$f" ] && echo "$f" && break; done)
    [ -n "$b" ] && { diag_libs "$dir/$b"; sandbox_exec "$dir/$b" "$@"; }
    echo "fifi-run: no launchable binary in $dir" >&2; exit 1
}

case "$target" in
    *.AppImage)
        base=$(basename "$target" .AppImage)
        ext="$(dirname "$target")/$base.d"
        if [ ! -d "$ext/squashfs-root" ]; then
            mkdir -p "$ext"
            chown 1000:1000 "$ext"
            ( cd "$ext" &&
              /bin/fifi-user-exec "$target" --appimage-extract >/dev/null 2>&1 )
        fi
        export APP_NAME="$base"
        launch_dir "$ext/squashfs-root" "$@"
        ;;
    *)
        diag_libs "$target"
        sandbox_exec "$target" "$@"
        ;;
esac
