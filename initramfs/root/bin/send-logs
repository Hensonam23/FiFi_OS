#!/bin/sh
# Send FiFi debug logs to a netcat listener on your main PC.
#
# On your main PC, run FIRST:
#   nc -l -p 9999 > /tmp/fifi-logs.txt
#
# Then run this with the main PC's local IP:
#   send-logs 192.168.x.x

TARGET_IP="${1:-}"
if [ -z "$TARGET_IP" ]; then
    echo "Usage: send-logs <ip>"
    echo ""
    echo "On your main PC run: nc -l -p 9999 > /tmp/fifi-logs.txt"
    echo "Then: send-logs <main-pc-ip>"
    exit 1
fi

echo "Sending logs to $TARGET_IP:9999..."
if ! ip -4 addr show scope global 2>/dev/null | grep -q 'inet '; then
    echo "No active IPv4 connection. Connect Wi-Fi or Ethernet first."
    exit 1
fi

if {
    echo "=== FiFi version ==="
    fifi version 2>&1
    echo ""
    echo "=== network ==="
    ip -4 addr show scope global 2>/dev/null
    ip -4 route 2>/dev/null
    echo ""
    echo "=== Wi-Fi devices ==="
    iw dev 2>&1
    rfkill list wifi 2>&1
    echo ""
    echo "=== Wi-Fi hardware ==="
    cat /fifi-data/wifi-hardware 2>/dev/null
    echo ""
    echo "=== latest Wi-Fi scan ==="
    cat /fifi-data/wifi-scan.log 2>/dev/null
    echo ""
    echo "=== Wi-Fi and network services ==="
    tail -n 500 /fifi-data/admin-broker.log 2>/dev/null
    tail -n 500 /fifi-data/wifi.log 2>/dev/null
    tail -n 500 /fifi-data/network.log 2>/dev/null
    echo ""
    echo "=== recent compositor.log ==="
    tail -n 2000 /fifi-data/compositor.log 2>/dev/null
    echo ""
    echo "=== input-devices.txt ==="
    cat /fifi-data/input-devices.txt 2>/dev/null
} | nc -w 15 "$TARGET_IP" 9999; then
    echo "Done."
else
    echo "Log transfer failed. Check the receiver address and firewall."
    exit 1
fi
