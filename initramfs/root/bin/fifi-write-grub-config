#!/bin/sh
# fifi-write-grub-config — atomically write the installed FiFi A/B GRUB menu.
set -eu

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || {
    echo "usage: fifi-write-grub-config CONFIG DATA_UUID [WINDOWS_CHAINLOADER]" >&2
    exit 2
}

CONFIG="$1"
DATA_UUID="$2"
WIN_CHAINLOAD="${3:-}"

printf '%s\n' "$DATA_UUID" | grep -Eq '^[A-Fa-f0-9-]+$' || {
    echo "fifi-write-grub-config: invalid data UUID" >&2
    exit 1
}
if [ -n "$WIN_CHAINLOAD" ]; then
    printf '%s\n' "$WIN_CHAINLOAD" |
        grep -Eq '^/EFI/[A-Za-z0-9._/-]+$' || {
        echo "fifi-write-grub-config: invalid Windows chainloader path" >&2
        exit 1
    }
fi

mkdir -p "$(dirname "$CONFIG")"
NEW="$CONFIG.new"
trap 'rm -f "$NEW"' EXIT

cat > "$NEW" << GRUBCFG
set timeout=5
set default=0
set fifi_grubenv=\$prefix/grubenv
insmod loadenv
load_env -f \$fifi_grubenv fifi_attempted
# Kernel + initramfs live on the DATA partition (ext4), not the EFI partition.
insmod part_gpt
insmod ext2
search --no-floppy --fs-uuid --set=root $DATA_UUID
source /boot/fifi-slot.cfg

set fifi_boot_fallback=0
set fifi_arm_attempt=0
set fifi_boot_slot=\$fifi_active
if [ "\$fifi_pending" = 1 ]; then
    if [ "\$fifi_attempted" = "\$fifi_attempt" ]; then
        set fifi_boot_fallback=1
        set fifi_boot_slot=\$fifi_previous
    else
        set fifi_arm_attempt=1
    fi
fi

menuentry "FiFi OS" {
    if [ "\$fifi_arm_attempt" = 1 ]; then
        set fifi_attempted=\$fifi_attempt
        save_env -f \$fifi_grubenv fifi_attempted
    fi
    search --no-floppy --fs-uuid --set=root $DATA_UUID
    linux /boot/bzImage.\$fifi_boot_slot console=tty0 quiet loglevel=3 fifi_data_uuid=$DATA_UUID fifi_slot=\$fifi_boot_slot fifi_boot_fallback=\$fifi_boot_fallback apparmor=1 security=apparmor i915.enable_psr=0 i915.enable_dc=0
    initrd /boot/initramfs.cpio.gz.\$fifi_boot_slot
}

submenu "Advanced options for FiFi OS" {
    menuentry "FiFi OS (safe graphics)" {
        search --no-floppy --fs-uuid --set=root $DATA_UUID
        linux /boot/bzImage.\$fifi_active console=tty0 quiet loglevel=3 nomodeset fifi_noswitch fifi_data_uuid=$DATA_UUID fifi_slot=\$fifi_active
        initrd /boot/initramfs.cpio.gz.\$fifi_active
    }

    menuentry "FiFi OS (previous working system)" {
        search --no-floppy --fs-uuid --set=root $DATA_UUID
        linux /boot/bzImage.\$fifi_previous console=tty0 quiet loglevel=3 fifi_data_uuid=$DATA_UUID fifi_slot=\$fifi_previous fifi_boot_fallback=1 apparmor=1 security=apparmor i915.enable_psr=0 i915.enable_dc=0
        initrd /boot/initramfs.cpio.gz.\$fifi_previous
    }
}
GRUBCFG

if [ -n "$WIN_CHAINLOAD" ]; then
    cat >> "$NEW" << WINCFG

menuentry "Windows Boot Manager" {
    insmod part_gpt
    insmod part_msdos
    insmod fat
    insmod chain
    insmod search_fs_file
    search --no-floppy --file --set=root $WIN_CHAINLOAD
    chainloader $WIN_CHAINLOAD
    boot
}
WINCFG
fi

mv -f "$NEW" "$CONFIG"
trap - EXIT
