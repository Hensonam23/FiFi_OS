#!/bin/sh
# fifi — FiFi OS control command.
#
#   fifi update            check for app + OS updates (don't change anything)
#   fifi upgrade           apply all available updates (asks first)
#   fifi upgrade -y        apply all updates without asking
#   fifi channel [name]    show or select stable/test updates
#   fifi rollback          restore the previous OS boot pair
#   fifi version           show the installed OS version
#   fifi help              show this help
#
# "update" then "upgrade" mirrors apt; a single `fifi upgrade` also re-checks
# first, so you can just run that. Apps come from the App Store, the OS from
# GitHub Releases (see system-update).

cmd="$1"
[ $# -gt 0 ] && shift

case "$cmd" in
    update)
        exec system-update -c ;;
    upgrade|up|-Syu)
        exec system-update "$@" ;;        # pass -y through
    channel)
        case "${1:-}" in
            stable|test) exec update "$1" ;;
            "") exec update channel ;;
            *) echo "usage: fifi channel [stable|test]" >&2; exit 2 ;;
        esac ;;
    rollback)
        exec update rollback ;;
    version|--version|-v)
        cat /etc/fifi-version 2>/dev/null || echo "FiFi OS (version unknown)"
        printf 'Build ID:  '
        cat /etc/fifi-build-id 2>/dev/null || echo unknown
        printf 'Channel:   '
        cat /etc/fifi-update-channel 2>/dev/null || echo unknown
        slot=""
        for word in $(cat /proc/cmdline 2>/dev/null); do
            case "$word" in fifi_slot=A) slot=A ;; fifi_slot=B) slot=B ;; esac
        done
        [ -n "$slot" ] || slot="legacy/unknown"
        printf 'Boot slot: %s\n' "$slot"
        running_build="$(cat /etc/fifi-build-id 2>/dev/null || true)"
        pending_build="$(cat /fifi-data/os-build-id.pending 2>/dev/null || true)"
        if [ -n "$pending_build" ] && [ "$pending_build" = "$running_build" ]; then
            printf 'State:     pending confirmation (%s)\n' "$pending_build"
        elif [ -n "$pending_build" ]; then
            printf 'State:     update staged in inactive slot (%s)\n' "$pending_build"
        else
            echo 'State:     confirmed'
        fi
        ;;
    ""|help|-h|--help)
        sed -n '3,11p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)
        echo "fifi: unknown command '$cmd'" >&2
        echo "try: fifi help" >&2
        exit 1 ;;
esac
