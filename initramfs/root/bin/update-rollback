#!/bin/sh
# update-rollback — swap the active and previous FiFi OS boot pairs.
set -eu

DATA_ROOT="${FIFI_DATA_ROOT:-/fifi-data}"
fail() { echo "[rollback] ERROR: $*" >&2; exit 1; }

was_pending=0
[ -s "$DATA_ROOT/os-build-id.pending" ] && was_pending=1
slot=$(FIFI_DATA_ROOT="$DATA_ROOT" fifi-boot-slots rollback) ||
    fail "could not switch boot slots"

if [ "$was_pending" = 0 ] && [ -f "$DATA_ROOT/os-build-id.prev" ]; then
    current=""
    [ -f "$DATA_ROOT/os-build-id" ] &&
        read -r current < "$DATA_ROOT/os-build-id"
    mv "$DATA_ROOT/os-build-id.prev" "$DATA_ROOT/os-build-id"
    [ -n "$current" ] &&
        printf '%s\n' "$current" > "$DATA_ROOT/os-build-id.prev"
fi
rm -f "$DATA_ROOT/os-build-id.pending"

sync
echo "[rollback] Previous FiFi OS restored in slot $slot. Reboot to use it."
