#!/bin/sh
if [ "$#" -ne 0 ]; then
    echo "usage: reboot" >&2
    exit 2
fi
# The broker's daemon owns the one proven kernel reboot syscall path.  Use it
# for root and desktop callers alike; BusyBox reports success under FiFi's
# custom init without actually rebooting this hardware.
exec "${FIFI_ADMIN_CLIENT:-fifi-admin}" power reboot
