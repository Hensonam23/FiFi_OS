#!/bin/sh
# update — FiFi OS in-place updater.
#
# Plain `update` first uses a plugged-in FiFi update USB, then falls back to the
# currently selected online channel. The installed /fifi-data partition,
# applications, settings, and user files are preserved.
#
#   update                 check, prompt, and install
#   update -y              install without prompting
#   update --check         check without changing anything
#   update test            select the test channel and install
#   update stable          return to the stable channel and install
#   update channel         show the selected channel
#   update rollback        restore the previous kernel + initramfs
#   update usb             update from a plugged-in FiFi live USB

DATA_ROOT="${FIFI_DATA_ROOT:-/fifi-data}"
CHANNEL_FILE="$DATA_ROOT/update-channel"

case "${1:-}" in
    test|stable)
        selected_channel="$1"
        shift
        mkdir -p "$DATA_ROOT" || exit 1
        printf '%s\n' "$selected_channel" > "$CHANNEL_FILE" || exit 1
        echo "[update] channel set to $selected_channel"
        exec system-update --channel "$selected_channel" "$@"
        ;;
    channel)
        if [ -s "$CHANNEL_FILE" ]; then
            read -r channel < "$CHANNEL_FILE"
        elif [ -s "${FIFI_ETC_ROOT:-/etc}/fifi-update-channel" ]; then
            read -r channel < "${FIFI_ETC_ROOT:-/etc}/fifi-update-channel"
        else
            channel=stable
        fi
        echo "$channel"
        ;;
    rollback)
        exec update-rollback
        ;;
    usb|--usb)
        shift
        exec update-usb "$@"
        ;;
    -h|--help|help)
        sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        # This makes the same command work before a test build has been
        # published: a recognized FiFi USB wins, while exit 2 means no USB was
        # present and the normal online updater should continue.
        if [ $# -eq 0 ] || [ "${1:-}" = "-y" ]; then
            update-usb --if-present "$@"
            usb_status=$?
            [ "$usb_status" -eq 0 ] && exit 0
            [ "$usb_status" -eq 2 ] || exit "$usb_status"
        fi
        exec system-update "$@"
        ;;
esac
