#!/bin/sh
# FiFi OS one-command developer setup.
# Clones the FiFi OS source repo. Just type: setup

if [ ! -d /fifi-data/linux-desktop ]; then
    echo "[setup] Cloning FiFi OS source to /fifi-data/linux-desktop..."
    curl -fL https://github.com/Hensonam23/FiFi_OS/archive/refs/heads/linux-desktop.tar.gz \
        | tar xz -C /fifi-data/ && \
        mv /fifi-data/FiFi_OS-linux-desktop /fifi-data/linux-desktop
    echo "[setup] Source ready."
else
    echo "[setup] Source already at /fifi-data/linux-desktop"
fi

echo ""
echo "[setup] All done."
echo ""
