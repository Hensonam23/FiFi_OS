#!/bin/sh
# system-update — verified in-place application and OS updates.
#
# OS images are selected from a persistent stable/test channel, downloaded from
# GitHub Releases, checked against the release manifest, staged beside the
# active boot files, and activated only after both downloads pass validation.

set -u

# Network access, release selection, and prompts run as the desktop user. Only
# the final re-verification and inactive-slot write cross the root broker.
if [ "$(id -u)" = 0 ] && [ -x /bin/fifi-user-exec ]; then
    exec /bin/fifi-user-exec "$0" "$@"
fi

REPO="${FIFI_UPDATE_REPO:-Hensonam23/FiFi_OS}"
DATA_ROOT="${FIFI_DATA_ROOT:-/fifi-data}"
ETC_ROOT="${FIFI_ETC_ROOT:-/etc}"
UPDATE_DIR="$DATA_ROOT/update"
STAGING="${FIFI_UPDATE_STAGING:-$UPDATE_DIR/staging}"
CHANNEL_FILE="$UPDATE_DIR/channel"
DEFAULT_CHANNEL_FILE="$ETC_ROOT/fifi-update-channel"
RELEASE_PUBLIC_KEY="${FIFI_RELEASE_PUBLIC_KEY:-$ETC_ROOT/fifi-release-signing.pub}"
BUILD_FILE="$DATA_ROOT/os-build-id"
PENDING_BUILD_FILE="$DATA_ROOT/os-build-id.pending"

MODE=ask
CHANNEL_OVERRIDE=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        -y|--yes) MODE=yes ;;
        -c|--check) MODE=check ;;
        --channel)
            shift
            [ "$#" -gt 0 ] || {
                echo "system-update: --channel requires stable or test" >&2
                exit 2
            }
            CHANNEL_OVERRIDE="$1"
            ;;
        -h|--help)
            sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "system-update: unknown option: $1" >&2
            exit 2
            ;;
    esac
    shift
done

channel="$CHANNEL_OVERRIDE"
if [ -z "$channel" ] && [ -s "$CHANNEL_FILE" ]; then
    read -r channel < "$CHANNEL_FILE"
fi
if [ -z "$channel" ] && [ -s "$DEFAULT_CHANNEL_FILE" ]; then
    read -r channel < "$DEFAULT_CHANNEL_FILE"
fi
[ -n "$channel" ] || channel=stable

case "$channel" in
    stable)
        API="https://api.github.com/repos/$REPO/releases/latest"
        ;;
    test)
        API="https://api.github.com/repos/$REPO/releases/tags/linux-desktop-test"
        ;;
    *)
        echo "system-update: invalid update channel '$channel'" >&2
        echo "Use: update stable  or  update test" >&2
        exit 2
        ;;
esac
mkdir -p "$STAGING" || {
    echo "system-update: cannot create private update staging" >&2
    exit 1
}
printf '%s\n' "$channel" > "$CHANNEL_FILE" || {
    echo "system-update: cannot save the selected update channel" >&2
    exit 1
}

echo "== Apps =="
if [ "${FIFI_SKIP_APP_UPDATE:-0}" = 1 ]; then
    echo "App update skipped by test environment."
elif command -v app-update >/dev/null 2>&1; then
    case "$MODE" in
        check) app-update -c ;;
        yes) app-update -y ;;
        *) app-update ;;
    esac
else
    echo "app-update not available; skipping app updates."
fi

echo
echo "== Operating system =="
echo "Channel:   $channel"
echo "Installed: $(cat "$ETC_ROOT/fifi-version" 2>/dev/null || echo unknown)"
echo "Checking GitHub release metadata..."

json=$(curl -fsSL --max-time 30 "$API" 2>/dev/null) || {
    echo "Could not retrieve the $channel update channel." >&2
    exit 1
}

tag=$(printf '%s' "$json" |
    grep -oE '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' |
    head -1 | sed 's/.*:[[:space:]]*"//;s/"$//')
[ -n "$tag" ] || {
    echo "The $channel channel has no published update." >&2
    exit 1
}

asset_url() {
    asset_name="$1"
    printf '%s' "$json" |
        grep -oE '"browser_download_url"[[:space:]]*:[[:space:]]*"[^"]*"' |
        sed 's/.*:[[:space:]]*"//;s/"$//' |
        grep "/$asset_name$" |
        head -1
}

manifest_url=$(asset_url fifi-update.manifest)
manifest_sig_url=$(asset_url fifi-update.manifest.sig)
kernel_url=$(asset_url bzImage)
initramfs_url=$(asset_url initramfs.cpio.gz)

if [ -z "$manifest_url" ] || [ -z "$manifest_sig_url" ] ||
   [ -z "$kernel_url" ] ||
   [ -z "$initramfs_url" ]; then
    echo "Release $tag is incomplete; required update assets are missing." >&2
    exit 1
fi

manifest_new="$STAGING/fifi-update.manifest"
manifest_sig_new="$STAGING/fifi-update.manifest.sig"
curl -fsSL --max-time 60 -o "$manifest_new" "$manifest_url" || {
    echo "Update manifest download failed." >&2
    exit 1
}
curl -fsSL --max-time 60 -o "$manifest_sig_new" "$manifest_sig_url" || {
    echo "Update manifest signature download failed." >&2
    rm -f "$manifest_new"
    exit 1
}
[ -s "$RELEASE_PUBLIC_KEY" ] || {
    echo "FiFi release verification key is missing; update refused." >&2
    rm -f "$manifest_new" "$manifest_sig_new"
    exit 1
}
openssl pkeyutl -verify -pubin -inkey "$RELEASE_PUBLIC_KEY" -rawin \
    -in "$manifest_new" -sigfile "$manifest_sig_new" >/dev/null 2>&1 || {
    echo "Update manifest signature is invalid; update refused." >&2
    rm -f "$manifest_new" "$manifest_sig_new"
    exit 1
}
manifest_value() {
    key="$1"
    sed -n "s/^${key}=\\([A-Za-z0-9._-]*\\)$/\\1/p" "$manifest_new" |
        head -1
}

manifest_version=$(manifest_value format)
manifest_channel=$(manifest_value channel)
build_id=$(manifest_value build)
kernel_sha=$(manifest_value kernel_sha256)
initramfs_sha=$(manifest_value initramfs_sha256)

[ "$manifest_version" = 1 ] || {
    echo "Unsupported or malformed update manifest." >&2
    rm -f "$manifest_new"
    exit 1
}
[ "$manifest_channel" = "$channel" ] || {
    echo "Update channel mismatch; refusing the release." >&2
    rm -f "$manifest_new"
    exit 1
}
[ -n "$build_id" ] || {
    echo "Update manifest has no build identifier." >&2
    rm -f "$manifest_new"
    exit 1
}
printf '%s\n' "$kernel_sha" | grep -Eq '^[0-9a-fA-F]{64}$' &&
printf '%s\n' "$initramfs_sha" | grep -Eq '^[0-9a-fA-F]{64}$' || {
    echo "Update manifest has invalid SHA-256 values." >&2
    rm -f "$manifest_new"
    exit 1
}

installed_build=""
[ -s "$BUILD_FILE" ] && read -r installed_build < "$BUILD_FILE"
echo "Available: $tag ($build_id)"

if [ "$installed_build" = "$build_id" ]; then
    echo "OS is already on the newest $channel build."
    rm -f "$manifest_new" "$manifest_sig_new"
    exit 0
fi
pending_build=""
[ -s "$PENDING_BUILD_FILE" ] && read -r pending_build < "$PENDING_BUILD_FILE"
if [ -n "$pending_build" ]; then
    echo "OS update $pending_build is installed in the inactive slot and awaits reboot."
    [ "$pending_build" = "$build_id" ] ||
        echo "Confirm or roll back that pending boot before installing $build_id."
    rm -f "$manifest_new" "$manifest_sig_new"
    exit 0
fi

echo "OS update available: $installed_build -> $build_id"
[ "$MODE" = check ] && {
    rm -f "$manifest_new" "$manifest_sig_new"
    exit 0
}

if [ "$MODE" = ask ]; then
    printf "Download and install this OS update now? [y/N] "
    read -r answer
    case "$answer" in
        y|Y|yes|YES) ;;
        *)
            echo "Skipped OS update."
            rm -f "$manifest_new" "$manifest_sig_new"
            exit 0
            ;;
    esac
fi

kernel_new="$STAGING/bzImage"
initramfs_new="$STAGING/initramfs.cpio.gz"
rm -f "$kernel_new" "$initramfs_new"

echo "Downloading kernel..."
curl -fL --max-time 600 -o "$kernel_new" "$kernel_url" || {
    echo "Kernel download failed." >&2
    rm -f "$manifest_new" "$kernel_new"
    exit 1
}

echo "Downloading system image..."
curl -fL --max-time 1800 -o "$initramfs_new" "$initramfs_url" || {
    echo "System image download failed." >&2
    rm -f "$manifest_new" "$kernel_new" "$initramfs_new"
    exit 1
}

actual_kernel_sha=$(sha256sum "$kernel_new" | awk '{print $1}')
actual_initramfs_sha=$(sha256sum "$initramfs_new" | awk '{print $1}')
if [ "$actual_kernel_sha" != "$kernel_sha" ] ||
   [ "$actual_initramfs_sha" != "$initramfs_sha" ]; then
    echo "Downloaded image checksum mismatch; active boot files are untouched." >&2
    rm -f "$manifest_new" "$kernel_new" "$initramfs_new"
    exit 1
fi

gzip -t "$initramfs_new" 2>/dev/null || {
    echo "Downloaded initramfs failed gzip validation." >&2
    rm -f "$manifest_new" "$kernel_new" "$initramfs_new"
    exit 1
}

echo "Signature, checksums, and initramfs validation passed."
printf '%s\n' "$tag" > "$STAGING/release-tag"

# The broker invokes an immutable helper which copies these user-owned files
# into root-owned snapshots and repeats every signature/hash validation.
exec "${FIFI_ADMIN_CLIENT:-fifi-admin}" update apply "$channel"
