#!/bin/sh
# FiFi OS — PID 1 init

# ── Mount essential virtual filesystems ──────────────────────────────────────
mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t devtmpfs none /dev
mount -t tmpfs    none /tmp
mount -t tmpfs    none /run

mkdir -p /dev/pts /dev/shm
mount -t devpts   none /dev/pts
mount -t tmpfs    none /dev/shm

# ── Kernel messages: quiet after boot ────────────────────────────────────────
echo 3 > /proc/sys/kernel/printk 2>/dev/null || true

# ── Hostname ──────────────────────────────────────────────────────────────────
echo "fifios" > /proc/sys/kernel/hostname 2>/dev/null || true

# ── PATH ──────────────────────────────────────────────────────────────────────
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=linux
export XDG_RUNTIME_DIR=/tmp
export WAYLAND_DISPLAY=wayland-0

# ── Banner ────────────────────────────────────────────────────────────────────
clear
cat /etc/fifi-banner

# ── Wait for input drivers to settle ─────────────────────────────────────────
sleep 3

mkdir -p /fifi-data

# Log input devices for debugging
cat /proc/bus/input/devices > /fifi-data/input-devices.txt 2>/dev/null || true
ls -la /dev/input/ >> /fifi-data/input-devices.txt 2>/dev/null || true

# ── Bring up ethernet in background (autoneg needs time) ─────────────────────
(
    # Bring up only real Ethernet interfaces (type=1, skips sit0/lo/tun/etc.)
    for iface in $(ls /sys/class/net/ 2>/dev/null); do
        type=$(cat /sys/class/net/$iface/type 2>/dev/null)
        [ "$type" = "1" ] && ip link set "$iface" up 2>/dev/null
    done
    for i in $(seq 1 30); do
        for iface in $(ls /sys/class/net/ 2>/dev/null); do
            type=$(cat /sys/class/net/$iface/type 2>/dev/null)
            [ "$type" != "1" ] && continue
            carrier=$(cat /sys/class/net/$iface/carrier 2>/dev/null)
            if [ "$carrier" = "1" ]; then
                echo "carrier on $iface at attempt $i" > /fifi-data/network.log
                udhcpc -i "$iface" -q -n -t 5 2>>/fifi-data/network.log && \
                    echo "dhcp ok" >> /fifi-data/network.log || \
                    echo "dhcp failed" >> /fifi-data/network.log
                ip addr show "$iface" >> /fifi-data/network.log 2>&1
                # Sync system clock via NTP (one-shot, best-effort)
                ntpd -q -n -p pool.ntp.org >> /fifi-data/network.log 2>&1 && \
                    echo "ntp ok" >> /fifi-data/network.log || \
                    echo "ntp failed (ok)" >> /fifi-data/network.log
                exit 0
            fi
        done
        sleep 1
    done
    echo "no carrier after 30s" > /fifi-data/network.log
) &

# ── Launch FiFi compositor ────────────────────────────────────────────────────
# Prevent glibc IFUNC from selecting AVX-512 paths — fifi kernel may not
# fully initialise ZMM XSAVE state, causing SIGILL on zmm instructions.
export GLIBC_TUNABLES="glibc.cpu.hwcaps=-AVX512F,-AVX512VL,-AVX512BW,-AVX512CD,-AVX512DQ,-AVX512IFMA,-AVX512VBMI"
if [ -x /bin/fifi-compositor ]; then
    exec /bin/fifi-compositor 2>/fifi-data/compositor.log
fi

# Fallback: shell if compositor not present
if [ -x /bin/ush ]; then
    exec /bin/ush
else
    exec /bin/sh
fi

exec /bin/sh
