#!/bin/sh
# FiFi OS — PID 1 init

# ── Stage 1: relocate to a real (tmpfs) root so pivot_root / bubblewrap work ──
# The initramfs root is the special `rootfs`, on which pivot_root is FORBIDDEN,
# so Steam and other bubblewrap-sandboxed apps fail. On the FIRST entry we copy
# the whole initramfs into a tmpfs and switch_root into it (a real filesystem
# where pivot_root works), then re-exec /init there. Everything after this block
# then runs on the tmpfs root exactly as before.
#
# Safety (this must never brick a boot):
#   - `/.fifi-realroot` marker: set in the new root so we never switch twice.
#   - Escape hatch: add `fifi_noswitch` to the GRUB kernel cmdline to skip this
#     entirely and boot straight off the initramfs (recovery path).
#   - Verify-before-switch: only switch if the copy produced a bootable root;
#     ANY failure unmounts the tmpfs and falls through to a normal initramfs boot.
if [ ! -e /.fifi-realroot ]; then
    _switch=1
    mount -t proc none /proc 2>/dev/null
    for _a in $(cat /proc/cmdline 2>/dev/null); do
        [ "$_a" = "fifi_noswitch" ] && _switch=0
        [ "$_a" = "fifi_live" ] && _switch=0   # live/installer USB: no switch_root
    done
    umount /proc 2>/dev/null || true
    if [ "$_switch" = 1 ] && mkdir -p /newroot 2>/dev/null && \
       mount -t tmpfs -o size=75% tmpfs /newroot 2>/dev/null; then
        for _d in /*; do
            case "$_d" in
                /newroot|/proc|/sys|/dev|/run|/tmp) continue ;;
            esac
            cp -a "$_d" /newroot/ 2>/dev/null || true
        done
        mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/run /newroot/tmp \
                 /newroot/fifi-data 2>/dev/null
        # Commit to the switch only if the new root is actually bootable.
        if [ -e /newroot/init ] && [ -x /newroot/bin/busybox ] && [ -d /newroot/usr/lib ]; then
            : > /newroot/.fifi-realroot
            exec switch_root /newroot /init
            # exec only returns on failure -> fall through to a normal boot
        fi
        umount /newroot 2>/dev/null || true
    fi
fi

# ── Mount essential virtual filesystems ──────────────────────────────────────
mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t devtmpfs none /dev
mount -t tmpfs    none /tmp
mount -t tmpfs    none /run

mkdir -p /dev/pts /dev/shm
mount -t devpts   none /dev/pts
mount -t tmpfs    none /dev/shm

# Standard /dev fd symlinks. devtmpfs doesn't create these, but bash process
# substitution `<(...)` and many programs need /dev/fd → /proc/self/fd (and the
# std streams). Their absence broke the Steam runtime's logger (which uses
# process substitution) and stalled the Steam webhelper's init; it's a general
# POSIX expectation, so create them system-wide.
ln -sf /proc/self/fd  /dev/fd
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
ln -sf /proc/kcore    /dev/core 2>/dev/null || true

# ── Kernel messages: quiet after boot ────────────────────────────────────────
echo 3 > /proc/sys/kernel/printk 2>/dev/null || true

# ── Hostname ──────────────────────────────────────────────────────────────────
echo "FiFiOS" > /proc/sys/kernel/hostname 2>/dev/null || true

# ── Performance: use the whole machine, don't idle at the frequency floor ─────
# Stock governors (powersave, or an unavailable "schedutil") pinned the CPU at
# its ~800MHz minimum. FiFi targets full performance, so put every CPU policy on
# the "performance" governor (always present on intel_pstate/amd_pstate/acpi),
# lift the max to the hardware ceiling, unlock turbo/boost, and bias energy hints
# toward performance. Everything is best-effort so it is a no-op on any machine
# that lacks a given knob ("no matter the system"). Runs before the desktop so
# boot itself is fast too.
set_knob() {
    [ -e "$1" ] || return 0
    (printf '%s\n' "$2" > "$1") 2>/dev/null || true
}
for _pol in /sys/devices/system/cpu/cpu*/cpufreq; do
    [ -d "$_pol" ] || continue
    set_knob "$_pol/scaling_governor" performance
    [ -r "$_pol/cpuinfo_max_freq" ] && \
        set_knob "$_pol/scaling_max_freq" "$(cat "$_pol/cpuinfo_max_freq")"
    set_knob "$_pol/energy_performance_preference" performance
done
# Turbo / boost (knob name differs by driver)
set_knob /sys/devices/system/cpu/intel_pstate/no_turbo 0
set_knob /sys/devices/system/cpu/intel_pstate/max_perf_pct 100
set_knob /sys/devices/system/cpu/cpufreq/boost 1
# GPU: request the top power/performance state where the driver exposes it
# (amdgpu/nvidia sysfs). Best-effort; native GPU apps benefit even while the
# compositor itself is still software-rendered.
for _g in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
    set_knob "$_g" high
done
# Memory: keep working sets in RAM (this box has plenty), enable THP for big apps
set_knob /proc/sys/vm/swappiness 10
set_knob /sys/kernel/mm/transparent_hugepage/enabled madvise
unset -f set_knob 2>/dev/null || true

# ── PATH ──────────────────────────────────────────────────────────────────────
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=xterm-256color
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export XDG_RUNTIME_DIR=/tmp
export WAYLAND_DISPLAY=wayland-0
export TZ=PST8PDT,M3.2.0,M11.1.0
export DISPLAY=:0
export LD_LIBRARY_PATH=/usr/lib:/usr/lib64
export PIPEWIRE_RUNTIME_DIR=/tmp
export PULSE_RUNTIME_PATH=/tmp/pulse
# Disable the GTK/at-spi accessibility bridge and D-Bus session autolaunch. There
# is no D-Bus/X11 session here; GTK apps (e.g. Firefox/LibreWolf) otherwise try to
# autolaunch a session bus for a11y, and that failing path crashes them when a
# menu/popup is shown. These make the attempt a graceful no-op instead.
export NO_AT_BRIDGE=1
export GTK_A11Y=none
export GNOME_ACCESSIBILITY=0
export DBUS_SESSION_BUS_ADDRESS=disabled:

# ── Banner ────────────────────────────────────────────────────────────────────
clear
cat /etc/fifi-banner

# ── Wait for input drivers to settle ─────────────────────────────────────────
sleep 3

mkdir -p /fifi-data

# ── Persistent storage: mount FIFI-DATA partition if installed to disk ────────
# The kernel cmdline may include fifi_data_uuid=<UUID> written by the installer.
# If found, mount that ext4 partition as /fifi-data so settings and software
# persist between reboots. Falls back to tmpfs-backed /fifi-data on live USB.
# Parse the data-partition UUID from the kernel cmdline. The installer has passed
# either a bare UUID or (historically) a whole blkid line, so accept both forms
# and discard anything that is not a clean UUID — we never trust it blindly, it is
# only a fast-path hint; the marker probe below is authoritative.
FIFI_DATA_UUID=""
FIFI_LIVE=0
FIFI_UPDATE_BOOT=0
FIFI_SELFTEST=0
for arg in $(cat /proc/cmdline 2>/dev/null); do
    case "$arg" in
        fifi_data_uuid=*) FIFI_DATA_UUID="${arg#fifi_data_uuid=}" ;;
        UUID=*)           [ -z "$FIFI_DATA_UUID" ] && FIFI_DATA_UUID="${arg#UUID=}" ;;
        fifi_live)        FIFI_LIVE=1 ;;   # booted from the install USB, not a disk
        fifi_update)      FIFI_UPDATE_BOOT=1 ;;
        fifi_selftest)    FIFI_SELFTEST=1 ;;
    esac
done
case "$FIFI_DATA_UUID" in *[!0-9A-Fa-f-]*|"") FIFI_DATA_UUID="" ;; esac
# A live/installer USB must NEVER adopt an already-installed FiFi data partition
# (that would boot the user straight into their existing install). Its GRUB sets
# fifi_live; when present we skip the probe below and run on tmpfs -> installer.

# Find the FIFI-DATA partition by its /installed marker. We cannot rely on udev
# (/dev/disk/by-uuid), a fixed device path, or a fixed partition list — the disk
# layout varies per machine and nvme/USB nodes can lag a few seconds behind /init.
# So poll /proc/partitions and mount-probe EVERY partition for the marker, retrying
# while devices settle. Marker found -> installed system (mount it); none -> live
# boot (tmpfs fallback). An installed disk is found on the first pass with no delay.
DATA_DEV=""
_pm="/tmp/_fifi_probe" ; mkdir -p "$_pm"
_try=0
while [ "$FIFI_LIVE" != 1 ] && [ -z "$DATA_DEV" ] && [ "$_try" -lt 20 ]; do
    # Fast path: udev by-uuid symlink, if one happens to exist
    if [ -n "$FIFI_DATA_UUID" ] && [ -b "/dev/disk/by-uuid/$FIFI_DATA_UUID" ]; then
        DATA_DEV="/dev/disk/by-uuid/$FIFI_DATA_UUID"
        break
    fi
    # Probe every partition the kernel currently knows about (skip whole disks and
    # virtual/loop/ram devices). read from a file, not a pipe, so DATA_DEV persists.
    while read -r _maj _min _blk _name _rest; do
        case "$_name" in
            ""|name|loop*|ram*|sr*|nbd*|dm-*|md*|zram*) continue ;;
            *[0-9]) : ;;   # partitions end in a digit
            *)      continue ;;
        esac
        _d="/dev/$_name"
        [ -b "$_d" ] || continue
        mount -t ext4 -o ro "$_d" "$_pm" 2>/dev/null || continue
        if [ -f "$_pm/installed" ]; then
            umount "$_pm" 2>/dev/null
            DATA_DEV="$_d"
            break
        fi
        umount "$_pm" 2>/dev/null
    done < /proc/partitions
    [ -n "$DATA_DEV" ] && break
    _try=$((_try + 1))
    sleep 1
done
rmdir "$_pm" 2>/dev/null

if [ -n "$DATA_DEV" ]; then
    mount -t ext4 "$DATA_DEV" /fifi-data 2>/dev/null && \
        echo "fifi-data: mounted $DATA_DEV" || \
        echo "fifi-data: mount of $DATA_DEV failed, using tmpfs"
elif [ "$FIFI_LIVE" = 1 ]; then
    echo "fifi-data: live/installer USB, using tmpfs (installer will run)"
else
    echo "fifi-data: no installed partition found, using tmpfs (live mode)"
fi

# A dedicated USB boot entry performs the complete installed-system update
# without opening a terminal. The updated system finishes migrations and online
# app updates automatically on its next normal boot.
if [ "$FIFI_UPDATE_BOOT" = 1 ]; then
    clear
    cat /etc/fifi-banner
    echo
    echo "Updating the installed FiFi OS..."
    if update-usb; then
        echo
        echo "Update installed successfully."
        echo "This computer will power off. Remove the USB, then turn it on."
        sync
        sleep 5
        poweroff -f
        # ACPI poweroff is not implemented by every machine/firmware pair.
        # SysRq is a second kernel-level path; the final loop guarantees PID 1
        # remains alive even if both mechanisms return unexpectedly.
        echo o > /proc/sysrq-trigger 2>/dev/null || true
        while :; do sleep 3600; done
    fi
    echo
    echo "The update could not be completed. No user data was changed."
    echo "This computer will power off. Reflash or replace the USB and retry."
    sync
    sleep 10
    poweroff -f
    echo o > /proc/sysrq-trigger 2>/dev/null || true
    while :; do sleep 3600; done
fi

# Track the running image on persistent storage. This also makes offline USB
# updates and GRUB rollback boots visible to the online updater.
if [ -s /etc/fifi-update-channel ] && [ ! -s /fifi-data/update-channel ]; then
    cp /etc/fifi-update-channel /fifi-data/update-channel 2>/dev/null || true
fi
if [ -s /etc/fifi-build-id ]; then
    _running_build="$(cat /etc/fifi-build-id 2>/dev/null)"
    _recorded_build="$(cat /fifi-data/os-build-id 2>/dev/null)"
    if [ ! -s /fifi-data/os-build-id.pending ] &&
       [ -n "$_running_build" ] && [ "$_running_build" != "$_recorded_build" ]; then
        [ -n "$_recorded_build" ] &&
            printf '%s\n' "$_recorded_build" > /fifi-data/os-build-id.prev
        printf '%s\n' "$_running_build" > /fifi-data/os-build-id
    fi
fi

# One-time security migration for systems that booted an older image. It removes
# only FiFi's known historical development key and preserves all owner keys.
if [ -x /usr/share/fifi/migrate-legacy-ssh-keys.sh ]; then
    /usr/share/fifi/migrate-legacy-ssh-keys.sh
fi

# Older installed EFI menus load the A/B compatibility symlinks but cannot
# automatically reject an unconfirmed slot. Refresh only the GRUB config whose
# embedded data UUID matches this installation, keeping a one-time backup.
if [ -x /usr/share/fifi/migrate-legacy-grub.sh ]; then
    /usr/share/fifi/migrate-legacy-grub.sh
fi

# Keep GUI applications at the desktop UID. Administrative actions cross this
# root-owned socket and are limited to the fixed verbs in fifi-admin.c.
if [ -x /bin/fifi-admin ]; then
    /bin/fifi-admin --daemon >>/fifi-data/admin-broker.log 2>&1 &
fi

# ── Loopback interface ────────────────────────────────────────────────────────
# Must be up before anything binds to 127.0.0.1 (IPC socket, DoH, Tor, etc.)
ip link set lo up 2>/dev/null
ip addr add 127.0.0.1/8 dev lo 2>/dev/null

# Persistent home for the unprivileged desktop account. Migrate ownership once;
# all ordinary apps and terminal shells run as uid/gid 1000.
mkdir -p /fifi-data/home /home/fifi
if [ ! -e /fifi-data/.home-owned-by-fifi ]; then
    chown -R 1000:1000 /fifi-data/home 2>/dev/null || true
    : > /fifi-data/.home-owned-by-fifi
fi
chown 1000:1000 /fifi-data/home /home/fifi
chmod 0700 /fifi-data/home /home/fifi
mount --bind /fifi-data/home /home/fifi 2>/dev/null || true

# Settings stores desktop preferences in one persistent file. Keep the data
# directory root-owned, but let the desktop identity update this exact file.
# Refuse an existing symlink so ownership changes cannot be redirected.
if [ ! -e /fifi-data/fifi-settings.conf ] &&
   [ ! -L /fifi-data/fifi-settings.conf ]; then
    : > /fifi-data/fifi-settings.conf
fi
if [ -f /fifi-data/fifi-settings.conf ] &&
   [ ! -L /fifi-data/fifi-settings.conf ]; then
    chown 1000:1000 /fifi-data/fifi-settings.conf
    chmod 0600 /fifi-data/fifi-settings.conf
fi

# Volume control is a normal desktop capability. Expose only ALSA mixer control
# nodes to the desktop group; playback and raw hardware nodes keep their modes.
for _audio_ctl in /dev/snd/controlC*; do
    [ -c "$_audio_ctl" ] || continue
    chown 0:1000 "$_audio_ctl"
    chmod 0660 "$_audio_ctl"
done

# Credentials written by older builds may have inherited a permissive umask.
for _secret in /fifi-data/wifi.conf /fifi-data/wpa.conf \
               /fifi-data/wg0.conf /fifi-data/torrc; do
    [ -f "$_secret" ] && chmod 0600 "$_secret"
done

# Apps expect standard tools in /usr/bin (#!/usr/bin/env shebangs, uname, etc.):
# link every busybox applet there unless a real binary already exists.
for _a in $(busybox --list); do
    [ -e "/usr/bin/$_a" ] || ln -sf /bin/busybox "/usr/bin/$_a"
done

# ── App platform: writable library, immutable helpers, and keymap ─────────────
mkdir -p /fifi-data/apps /fifi-data/runtime/etc/fonts /fifi-data/runtime/cache/fontconfig
# Older builds mirrored root-executed helpers into the persistent app library.
# Remove those copies once, then migrate installed apps to the desktop identity.
# Root code below executes only immutable helpers from the signed OS image.
if [ ! -e /fifi-data/.apps-owned-by-fifi ]; then
    rm -f /fifi-data/apps/fifi-run \
          /fifi-data/apps/appstore-install.sh \
          /fifi-data/apps/appstore-sync.sh \
          /fifi-data/apps/appstore-uninstall.sh \
          /fifi-data/apps/appstore-update-check.sh \
          /fifi-data/apps/fifi-appstore
    if chown -RhP 1000:1000 /fifi-data/apps; then
        : > /fifi-data/.apps-owned-by-fifi
    fi
fi
chown 1000:1000 /fifi-data/apps
chmod 0700 /fifi-data/apps
if [ ! -e /fifi-data/fifi-desktop.conf ] &&
   [ ! -L /fifi-data/fifi-desktop.conf ]; then
    : > /fifi-data/fifi-desktop.conf
fi
if [ -f /fifi-data/fifi-desktop.conf ] &&
   [ ! -L /fifi-data/fifi-desktop.conf ]; then
    chown 1000:1000 /fifi-data/fifi-desktop.conf
    chmod 0600 /fifi-data/fifi-desktop.conf
fi
# Replace any cached catalog before the App Store reads it, without root writes
# into the user-owned library.
[ -f /usr/share/fifi/appstore-sync.sh ] &&
    /bin/fifi-user-exec /bin/sh /usr/share/fifi/appstore-sync.sh \
        >/dev/null 2>&1 || true
# Older installs used an unsigned versionless LibreOffice URL. Move its recorded
# update source to the digest-bearing GitHub release channel.
/bin/fifi-user-exec /bin/sh /usr/share/fifi/migrate-app-library.sh \
    >/dev/null 2>&1 || true

# Check installed apps for updates once the network has had time to come up —
# the App Store then shows Update buttons without a manual "Check Updates".
# Offline-safe: the check just fails quietly and retries next boot.
( sleep 25
  # Trial provisioning: on a fresh/live system the desktop has LibreWolf +
  # LibreOffice ICONS but not the AppImages (those download on demand). Fetch the
  # two flagship apps in the background so a fresh install / live trial is usable
  # out of the box. Only when missing AND the network is reachable; offline-safe
  # (fails quietly, retries next boot). Each is ~130MB / ~330MB so this runs
  # detached and the apps simply appear once downloaded.
  if [ -f /usr/share/fifi/appstore-install.sh ] && \
     curl -fsI --max-time 10 https://gitlab.com >/dev/null 2>&1; then
      [ -f /fifi-data/apps/LibreWolf.AppImage ] || \
          /bin/fifi-user-exec /bin/sh /usr/share/fifi/appstore-install.sh \
              'gitlab:librewolf-community%2Fbrowser%2Fappimage' LibreWolf >/dev/null 2>&1
      [ -f /fifi-data/apps/LibreOffice.AppImage ] || \
          /bin/fifi-user-exec /bin/sh /usr/share/fifi/appstore-install.sh \
              'ivan-hc/LibreOffice-appimage' LibreOffice >/dev/null 2>&1
  fi
  [ -f /usr/share/fifi/appstore-update-check.sh ] && \
      /bin/fifi-user-exec /bin/sh /usr/share/fifi/appstore-update-check.sh \
          >/dev/null 2>&1 ) &
# OS-managed too — always refresh so keymap/fontconfig fixes are never shadowed
# by a stale copy on an existing data partition.
cp /usr/share/fifi/fifi-keymap.txt /fifi-data/fifi-keymap.txt 2>/dev/null || true
cp /usr/share/fifi/fifi-fonts.conf /fifi-data/runtime/etc/fonts/fonts.conf 2>/dev/null || true

# Bundled app icons (built-in + standalone apps) — copy any missing into /fifi-data/icons.
mkdir -p /fifi-data/icons
if [ -d /usr/share/fifi/icons ]; then
    for ic in /usr/share/fifi/icons/*.png; do
        [ -f "$ic" ] || continue
        b=$(basename "$ic")
        [ -f "/fifi-data/icons/$b" ] || cp "$ic" "/fifi-data/icons/$b" 2>/dev/null || true
    done
fi

# Bundled TTF/OTF fonts — seed into /fifi-data/fonts so the Settings font picker
# (which scans /fonts -> /fifi-data/fonts) has fonts on a fresh install. The
# mounted data partition shadows the baked copy, so seed onto it here.
mkdir -p /fifi-data/fonts
if [ -d /usr/share/fifi/fonts ]; then
    # .psf too: the App Store + other FiFi apps load /fifi-data/fonts/ter16b.psf;
    # without it their text renders blank (they fall back to an empty glyph set).
    for ft in /usr/share/fifi/fonts/*.ttf /usr/share/fifi/fonts/*.otf \
              /usr/share/fifi/fonts/*.ttc /usr/share/fifi/fonts/*.psf; do
        [ -f "$ft" ] || continue
        b=$(basename "$ft")
        [ -f "/fifi-data/fonts/$b" ] || cp "$ft" "/fifi-data/fonts/$b" 2>/dev/null || true
    done
fi

# Log input devices for debugging
cat /proc/bus/input/devices > /fifi-data/input-devices.txt 2>/dev/null || true
ls -la /dev/input/ >> /fifi-data/input-devices.txt 2>/dev/null || true

# ── SSH server (Dropbear) — disabled until the owner installs a key ──────────
# To opt in, place a public key in /fifi-data/ssh/authorized_keys and reboot.
# Password auth is disabled; no authorization key is baked into the OS image.
if [ -x /usr/sbin/dropbear ] && [ -x /usr/bin/dropbearkey ] &&
   [ -s /fifi-data/ssh/authorized_keys ]; then
    mkdir -p /fifi-data/ssh
    chmod 700 /fifi-data/ssh
    chmod 600 /fifi-data/ssh/authorized_keys

    # Generate host keys on first boot (stored in /fifi-data/ssh — survives updates)
    [ -f /fifi-data/ssh/dropbear_ed25519_host_key ] || \
        /usr/bin/dropbearkey -t ed25519 -f /fifi-data/ssh/dropbear_ed25519_host_key \
            >>/fifi-data/sshd.log 2>&1
    [ -f /fifi-data/ssh/dropbear_rsa_host_key ] || \
        /usr/bin/dropbearkey -t rsa -s 3072 -f /fifi-data/ssh/dropbear_rsa_host_key \
            >>/fifi-data/sshd.log 2>&1

    # Ensure /etc/passwd + /etc/group exist (dropbear needs them to resolve root's home)
    [ -f /etc/passwd ] || echo 'root:x:0:0:root:/root:/bin/sh' > /etc/passwd
    [ -f /etc/group ]  || echo 'root:x:0:' > /etc/group

    # Dropbear can reject a symlinked ~/.ssh, so copy the owner-managed,
    # persistent key file into a real root-owned directory on every boot.
    mkdir -p /root/.ssh
    chmod 700 /root/.ssh
    cp /fifi-data/ssh/authorized_keys /root/.ssh/authorized_keys
    chmod 600 /root/.ssh/authorized_keys

    # Start dropbear: key-only auth (-s), disable port forwarding (-j -k)
    /usr/sbin/dropbear \
        -r /fifi-data/ssh/dropbear_ed25519_host_key \
        -r /fifi-data/ssh/dropbear_rsa_host_key \
        -p 22 -s -j -k -I 3600 \
        >>/fifi-data/sshd.log 2>&1 && \
        echo "ssh: dropbear started on port 22" >> /fifi-data/network.log || \
        echo "ssh: dropbear failed to start — check /fifi-data/sshd.log" >> /fifi-data/network.log
else
    echo "ssh: disabled (install /fifi-data/ssh/authorized_keys to enable)" >> /fifi-data/network.log
fi

# ── Bluetooth: root-mode system D-Bus + bluetoothd (no-op if not bundled) ─────
# Enables pairing via `bt` / bluetoothctl and A2DP audio via PipeWire's bluez5
# plugin. Adapters auto-power-on per /etc/bluetooth/main.conf.
if [ -x /usr/lib/bluetooth/bluetoothd ] && [ -x /usr/bin/dbus-daemon ]; then
    [ -f /etc/machine-id ] || /usr/bin/dbus-uuidgen > /etc/machine-id 2>/dev/null || true
    mkdir -p /run/dbus /var/lib/bluetooth
    [ -S /run/dbus/system_bus_socket ] || \
        /usr/bin/dbus-daemon --system --fork >>/fifi-data/bluetooth.log 2>&1 || true
    /usr/lib/bluetooth/bluetoothd >>/fifi-data/bluetooth.log 2>&1 &
    echo "bluetooth: dbus + bluetoothd started" >> /fifi-data/network.log
fi

# ── Bring up ethernet in background (autoneg needs time) ─────────────────────
(
    # Bring up only real Ethernet interfaces (type=1, skips sit0/lo/tun/etc.)
    for iface in $(ls /sys/class/net/ 2>/dev/null); do
        type=$(cat /sys/class/net/$iface/type 2>/dev/null)
        [ "$type" = "1" ] && ip link set "$iface" up 2>/dev/null
    done
    for i in $(seq 1 30); do
        for iface in $(ls /sys/class/net/ 2>/dev/null); do
            type=$(cat /sys/class/net/$iface/type 2>/dev/null)
            [ "$type" != "1" ] && continue
            carrier=$(cat /sys/class/net/$iface/carrier 2>/dev/null)
            if [ "$carrier" = "1" ]; then
                echo "carrier on $iface at attempt $i" > /fifi-data/network.log
                udhcpc -i "$iface" -q -n -t 5 2>>/fifi-data/network.log && \
                    echo "dhcp ok" >> /fifi-data/network.log || \
                    echo "dhcp failed" >> /fifi-data/network.log
                ip addr show "$iface" >> /fifi-data/network.log 2>&1
                # Sync system clock via NTP (one-shot, best-effort)
                # Try hostname first (requires resolv.conf from udhcpc script),
                # fall back to Google NTP IP if DNS not ready yet.
                ntpd -q -n -p pool.ntp.org >> /fifi-data/network.log 2>&1 || \
                    ntpd -q -n -p 216.239.35.0 >> /fifi-data/network.log 2>&1
                if [ "$?" = "0" ]; then
                    echo "ntp ok" >> /fifi-data/network.log
                else
                    echo "ntp failed (ok)" >> /fifi-data/network.log
                fi
                # Start DoH if enabled (dnscrypt-proxy listens on 127.0.0.1:53)
                if [ -f /fifi-data/doh-enabled ] && [ -x /usr/bin/dnscrypt-proxy ]; then
                    /usr/bin/dnscrypt-proxy -config /etc/dnscrypt-proxy.toml \
                        >>/fifi-data/doh.log 2>&1 &
                    echo $! > /fifi-data/doh.pid
                    sleep 1
                    echo "nameserver 127.0.0.1" > /etc/resolv.conf
                    echo "doh: started pid=$(cat /fifi-data/doh.pid)" >> /fifi-data/network.log
                fi
                # Auto-connect WireGuard VPN if requested
                if [ -f /fifi-data/vpn-autoconnect ] && [ -f /fifi-data/wg0.conf ]; then
                    /bin/sh /bin/wg-up >>/fifi-data/vpn.log 2>&1
                    echo "vpn: autoconnect attempted" >> /fifi-data/network.log
                fi
                # Restart Tor if it was previously enabled
                if [ -f /fifi-data/tor-enabled ] && [ -x /usr/bin/tor ]; then
                    mkdir -p /fifi-data/tor
                    # Rewrite torrc with current settings (includes FascistFirewall for port 443)
                    cat > /fifi-data/torrc << 'TORRC'
SocksPort 9050
DNSPort 5353
DataDirectory /fifi-data/tor
Log notice file /fifi-data/tor.log
FascistFirewall 1
ReachableAddresses *:80,*:443
CircuitBuildTimeout 120
LearnCircuitBuildTimeout 0
FetchUselessDescriptors 0
DirReqStatistics 0
StrictNodes 0
NumEntryGuards 6
TORRC
                    /usr/bin/tor -f /fifi-data/torrc >>/fifi-data/tor.log 2>&1 &
                    echo $! > /fifi-data/tor.pid
                    echo "tor: started pid=$(cat /fifi-data/tor.pid)" >> /fifi-data/network.log
                fi
                exit 0
            fi
        done
        sleep 1
    done
    echo "no carrier after 30s" > /fifi-data/network.log
) &

# A USB update may need the installed system's saved Wi-Fi configuration, and
# every update should leave applications current too. Complete that work in the
# background once networking is available; failures remain pending for retry.
if [ -x /usr/share/fifi/complete-pending-update.sh ]; then
    /usr/share/fifi/complete-pending-update.sh &
fi

# ── WiFi auto-connect via iwd ─────────────────────────────────────────────────
# Runs in parallel with ethernet negotiation. Reads /fifi-data/wifi.conf:
#   SSID=YourNetworkName
#   PASSWORD=YourPassword
(
    if [ ! -f /fifi-data/wifi.conf ] || [ ! -x /usr/lib/iwd/iwd ]; then
        exit 0
    fi
    # Parse wifi.conf
    WIFI_SSID="" WIFI_PASS=""
    while IFS='=' read -r k v; do
        case "$k" in
            SSID)     WIFI_SSID="$v" ;;
            PASSWORD) WIFI_PASS="$v" ;;
        esac
    done < /fifi-data/wifi.conf
    [ -z "$WIFI_SSID" ] && exit 0

    # Wait for WiFi interface to appear (firmware load takes a moment)
    WIFI_IF=""
    for i in $(seq 1 10); do
        for iface in $(ls /sys/class/net/ 2>/dev/null); do
            [ -d "/sys/class/net/$iface/wireless" ] && WIFI_IF="$iface" && break 2
        done
        sleep 1
    done
    [ -z "$WIFI_IF" ] && echo "wifi: no wireless interface found" >> /fifi-data/network.log && exit 0
    echo "wifi: found interface $WIFI_IF" >> /fifi-data/network.log

    # Set up iwd network profile
    mkdir -p /var/lib/iwd /etc/iwd
    printf '[Security]\nPassphrase=%s\n' "$WIFI_PASS" > "/var/lib/iwd/${WIFI_SSID}.psk"
    # iwd main.conf: use its built-in DHCP client
    cat > /etc/iwd/main.conf << 'IWDCONF'
[General]
EnableNetworkConfiguration=true

[Network]
EnableIPv6=false
NameResolvingService=none
IWDCONF

    # Start iwd (it will auto-connect to the saved profile)
    /usr/lib/iwd/iwd > /fifi-data/wifi.log 2>&1 &
    echo $! > /fifi-data/wifi.pid
    echo "wifi: iwd started, connecting to $WIFI_SSID..." >> /fifi-data/network.log

    # Wait up to 30s for an IP on the WiFi interface
    for i in $(seq 1 30); do
        sleep 1
        WIFI_IP=$(ip -4 addr show "$WIFI_IF" 2>/dev/null | grep "inet " | awk '{print $2}' | cut -d/ -f1)
        if [ -n "$WIFI_IP" ]; then
            echo "wifi: connected to $WIFI_SSID ip=$WIFI_IP" >> /fifi-data/network.log
            echo "$WIFI_SSID" > /fifi-data/wifi-ssid
            echo "connected" > /fifi-data/wifi-status
            # Set DNS if not already set by ethernet or DoH
            if ! grep -q "nameserver" /etc/resolv.conf 2>/dev/null; then
                echo "nameserver 8.8.8.8" > /etc/resolv.conf
            fi
            exit 0
        fi
    done
    echo "wifi: timeout connecting to $WIFI_SSID" >> /fifi-data/network.log
    echo "disconnected" > /fifi-data/wifi-status
) &

# ── AppArmor — load profiles in complain mode ────────────────────────────────
if [ -x /usr/bin/apparmor_parser ] && [ -d /etc/apparmor.d ]; then
    # Mount securityfs so AppArmor can load profiles
    mount -t securityfs securityfs /sys/kernel/security 2>/dev/null || true
    # Load all profiles in complain mode (logs violations, doesn't block)
    for profile in /etc/apparmor.d/fifi-*; do
        [ -f "$profile" ] && /usr/bin/apparmor_parser -C "$profile" 2>>/fifi-data/apparmor.log || true
    done
    echo "apparmor: profiles loaded (complain mode)" > /fifi-data/apparmor-status
else
    echo "apparmor: not available (kernel support required)" > /fifi-data/apparmor-status
fi

# ── Phase 5: Firewall — apply nftables default-deny inbound rules ─────────────
if [ -x /usr/sbin/nft ] && [ -f /etc/nftables.conf ]; then
    /usr/sbin/nft -f /etc/nftables.conf 2>/fifi-data/firewall.log && \
        echo "firewall: active" >> /fifi-data/firewall.log || \
        echo "firewall: failed (kernel nftables support required)" >> /fifi-data/firewall.log
    if [ -s /fifi-data/ssh/authorized_keys ] && pidof dropbear >/dev/null 2>&1; then
        /usr/sbin/nft add rule inet fifi_filter input tcp dport 22 accept \
            2>>/fifi-data/firewall.log || \
            echo "firewall: failed to allow opted-in SSH" >> /fifi-data/firewall.log
    fi
else
    echo "firewall: nft or rules not found" > /fifi-data/firewall.log
fi

# ── PipeWire audio daemon (multi-app mixing, PulseAudio-compatible) ──────────
mkdir -p /tmp/pulse
if [ -x /usr/bin/pipewire ]; then
    /usr/bin/pipewire -c /usr/share/pipewire/fifi.conf >/fifi-data/pipewire.log 2>&1 &
fi

# XWayland is started and owned by the compositor's XWM. Starting a second
# rootless server here races it for display :0 and leaves a dead child behind.

mkdir -p /usr/local/bin

# ── Persistent user-installed tools ───────────────────────────────────────────
# Anything the user installs into /fifi-data survives OS updates. Expose tools
# placed in /fifi-data/bin on the PATH (symlinked into /usr/local/bin), and run
# an optional /fifi-data/profile for any custom environment setup. This is a
# generic mechanism — no specific tool is referenced in the OS source.
if [ -d /fifi-data/bin ]; then
    for _t in /fifi-data/bin/*; do
        [ -x "$_t" ] && ln -sf "$_t" /usr/local/bin/"$(basename "$_t")"
    done
fi
[ -f /fifi-data/profile ] && . /fifi-data/profile
export PATH="/usr/local/bin:$PATH"

# ── Supervise FiFi compositor ─────────────────────────────────────────────────
# Prevent glibc IFUNC from selecting AVX-512 paths — fifi kernel may not
# fully initialise ZMM XSAVE state, causing SIGILL on zmm instructions.
export GLIBC_TUNABLES="glibc.cpu.hwcaps=-AVX512F,-AVX512VL,-AVX512BW,-AVX512CD,-AVX512DQ,-AVX512IFMA,-AVX512VBMI"
# A persistent development compositor is opt-in so stale experiments cannot
# silently mask the compositor shipped by a system update.
FIFI_COMPOSITOR=""
if [ -f /fifi-data/dev-mode ] &&
   [ -x /fifi-data/fifi-compositor ] &&
   ! grep -q fifi_noswitch /proc/cmdline; then
    FIFI_COMPOSITOR=/fifi-data/fifi-compositor
fi
if [ -z "$FIFI_COMPOSITOR" ] && [ -x /bin/fifi-compositor ]; then
    FIFI_COMPOSITOR=/bin/fifi-compositor
fi

# The automated boot gate waits for both compositor sockets, verifies their
# ownership, then launches one ordinary app through the real privilege boundary.
# Results go to serial so the host can make a deterministic pass/fail decision.
fifi_boot_selftest() {
    _tries=0
    while [ "$_tries" -lt 120 ]; do
        if [ -S /tmp/fifi-compositor.sock ] && [ -S /tmp/wayland-0 ]; then
            _ipc_mode="$(stat -c '%u:%g:%a' /tmp/fifi-compositor.sock 2>/dev/null)"
            _wayland_mode="$(stat -c '%u:%g:%a' /tmp/wayland-0 2>/dev/null)"
            _apps_mode="$(stat -c '%u:%g:%a' /fifi-data/apps 2>/dev/null)"
            _desktop_conf_mode="$(stat -c '%u:%g:%a' /fifi-data/fifi-desktop.conf 2>/dev/null)"
            _settings_mode="$(stat -c '%u:%g:%a' /fifi-data/fifi-settings.conf 2>/dev/null)"
            if [ "$_ipc_mode" != "0:1000:660" ] ||
               [ "$_wayland_mode" != "1000:1000:600" ]; then
                printf 'FIFI_SELFTEST FAIL socket-permissions ipc=%s wayland=%s\n' \
                    "$_ipc_mode" "$_wayland_mode" >/dev/ttyS0
                return
            fi
            if [ "$_apps_mode" != "1000:1000:700" ] ||
               [ "$_desktop_conf_mode" != "1000:1000:600" ] ||
               [ "$_settings_mode" != "1000:1000:600" ]; then
                printf 'FIFI_SELFTEST FAIL user-storage apps=%s desktop-conf=%s settings=%s\n' \
                    "$_apps_mode" "$_desktop_conf_mode" "$_settings_mode" >/dev/ttyS0
                return
            fi

            /bin/fifi-user-exec /bin/fifi-calc \
                >/tmp/fifi-selftest-app.log 2>&1 &
            _app_pid=$!
            sleep 3
            _app_uid="$(awk '/^Uid:/{print $2}' "/proc/$_app_pid/status" 2>/dev/null)"
            if kill -0 "$_app_pid" 2>/dev/null && [ "$_app_uid" = 1000 ]; then
                printf 'FIFI_SELFTEST PASS compositor-ready app-uid=1000\n' \
                    >/dev/ttyS0
                return
            fi
            printf 'FIFI_SELFTEST FAIL unprivileged-app uid=%s\n' \
                "${_app_uid:-missing}" >/dev/ttyS0
            return
        fi
        _tries=$((_tries + 1))
        sleep 1
    done
    printf 'FIFI_SELFTEST FAIL compositor-timeout\n' >/dev/ttyS0
}

# A pending slot becomes trusted only after the shipped compositor creates both
# desktop sockets. If GRUB selected the previous slot after a failed attempt,
# this same transition makes that fallback permanent and discards the pending
# build marker. Until this point the next boot automatically retries the known
# good slot instead of the unconfirmed image.
fifi_confirm_boot_success() {
    [ -f /fifi-data/installed ] || return
    _tries=0
    while [ "$_tries" -lt 120 ]; do
        if [ -S /tmp/fifi-compositor.sock ] && [ -S /tmp/wayland-0 ]; then
            fifi-confirm-boot >>/fifi-data/boot-slots.log 2>&1 || return
            return
        fi
        _tries=$((_tries + 1))
        sleep 1
    done
    printf '%s\n' "boot slot remains pending: compositor readiness timed out" \
        >>/fifi-data/boot-slots.log
}

# Keep the init shell as PID 1. Besides restarting the desktop after a crash,
# this makes it the permanent parent/reaper for boot-time helpers and prevents
# exited network/service wrappers from accumulating as zombie processes.
if [ -n "$FIFI_COMPOSITOR" ]; then
    fifi_confirm_boot_success &
    while :; do
        if [ "$FIFI_SELFTEST" = 1 ]; then
            fifi_boot_selftest &
        fi
        "$FIFI_COMPOSITOR" 2>>/fifi-data/compositor.log
        FIFI_COMPOSITOR_STATUS=$?
        printf '%s compositor exited status=%s; restarting in 2s\n' \
            "$(date -Iseconds 2>/dev/null || date)" "$FIFI_COMPOSITOR_STATUS" \
            >>/fifi-data/compositor-supervisor.log
        sleep 2
    done
fi

# Fallback: shell if compositor not present
if [ -x /bin/ush ]; then
    exec /bin/ush
else
    exec /bin/sh
fi

exec /bin/sh
