#!/bin/sh
# FiFi OS — PID 1 init

# ── Mount essential virtual filesystems ──────────────────────────────────────
mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t devtmpfs none /dev
mount -t tmpfs    none /tmp
mount -t tmpfs    none /run

mkdir -p /dev/pts /dev/shm
mount -t devpts   none /dev/pts
mount -t tmpfs    none /dev/shm

# ── Kernel messages: quiet after boot ────────────────────────────────────────
echo 3 > /proc/sys/kernel/printk 2>/dev/null || true

# ── Hostname ──────────────────────────────────────────────────────────────────
echo "FiFiOS" > /proc/sys/kernel/hostname 2>/dev/null || true

# ── PATH ──────────────────────────────────────────────────────────────────────
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=linux
export XDG_RUNTIME_DIR=/tmp
export WAYLAND_DISPLAY=wayland-0
export TZ=PST8PDT,M3.2.0,M11.1.0
export DISPLAY=:0
export LD_LIBRARY_PATH=/usr/lib:/usr/lib64
export PIPEWIRE_RUNTIME_DIR=/tmp
export PULSE_RUNTIME_PATH=/tmp/pulse

# ── Banner ────────────────────────────────────────────────────────────────────
clear
cat /etc/fifi-banner

# ── Wait for input drivers to settle ─────────────────────────────────────────
sleep 3

mkdir -p /fifi-data

# ── Loopback interface ────────────────────────────────────────────────────────
# Must be up before anything binds to 127.0.0.1 (IPC socket, DoH, Tor, etc.)
ip link set lo up 2>/dev/null
ip addr add 127.0.0.1/8 dev lo 2>/dev/null

# Log input devices for debugging
cat /proc/bus/input/devices > /fifi-data/input-devices.txt 2>/dev/null || true
ls -la /dev/input/ >> /fifi-data/input-devices.txt 2>/dev/null || true

# ── Bring up ethernet in background (autoneg needs time) ─────────────────────
(
    # Bring up only real Ethernet interfaces (type=1, skips sit0/lo/tun/etc.)
    for iface in $(ls /sys/class/net/ 2>/dev/null); do
        type=$(cat /sys/class/net/$iface/type 2>/dev/null)
        [ "$type" = "1" ] && ip link set "$iface" up 2>/dev/null
    done
    for i in $(seq 1 30); do
        for iface in $(ls /sys/class/net/ 2>/dev/null); do
            type=$(cat /sys/class/net/$iface/type 2>/dev/null)
            [ "$type" != "1" ] && continue
            carrier=$(cat /sys/class/net/$iface/carrier 2>/dev/null)
            if [ "$carrier" = "1" ]; then
                echo "carrier on $iface at attempt $i" > /fifi-data/network.log
                udhcpc -i "$iface" -q -n -t 5 2>>/fifi-data/network.log && \
                    echo "dhcp ok" >> /fifi-data/network.log || \
                    echo "dhcp failed" >> /fifi-data/network.log
                ip addr show "$iface" >> /fifi-data/network.log 2>&1
                # Sync system clock via NTP (one-shot, best-effort)
                # Try hostname first (requires resolv.conf from udhcpc script),
                # fall back to Google NTP IP if DNS not ready yet.
                ntpd -q -n -p pool.ntp.org >> /fifi-data/network.log 2>&1 || \
                    ntpd -q -n -p 216.239.35.0 >> /fifi-data/network.log 2>&1
                if [ "$?" = "0" ]; then
                    echo "ntp ok" >> /fifi-data/network.log
                else
                    echo "ntp failed (ok)" >> /fifi-data/network.log
                fi
                # Start DoH if enabled (dnscrypt-proxy listens on 127.0.0.1:53)
                if [ -f /fifi-data/doh-enabled ] && [ -x /usr/bin/dnscrypt-proxy ]; then
                    /usr/bin/dnscrypt-proxy -config /etc/dnscrypt-proxy.toml \
                        >>/fifi-data/doh.log 2>&1 &
                    echo $! > /fifi-data/doh.pid
                    sleep 1
                    echo "nameserver 127.0.0.1" > /etc/resolv.conf
                    echo "doh: started pid=$(cat /fifi-data/doh.pid)" >> /fifi-data/network.log
                fi
                # Auto-connect WireGuard VPN if requested
                if [ -f /fifi-data/vpn-autoconnect ] && [ -f /fifi-data/wg0.conf ]; then
                    /bin/sh /bin/wg-up >>/fifi-data/vpn.log 2>&1
                    echo "vpn: autoconnect attempted" >> /fifi-data/network.log
                fi
                # Restart Tor if it was previously enabled
                if [ -f /fifi-data/tor-enabled ] && [ -x /usr/bin/tor ]; then
                    mkdir -p /fifi-data/tor
                    # Rewrite torrc with current settings (includes FascistFirewall for port 443)
                    cat > /fifi-data/torrc << 'TORRC'
SocksPort 9050
DNSPort 5353
DataDirectory /fifi-data/tor
Log notice file /fifi-data/tor.log
FascistFirewall 1
ReachableAddresses *:80,*:443
CircuitBuildTimeout 120
LearnCircuitBuildTimeout 0
FetchUselessDescriptors 0
DirReqStatistics 0
StrictNodes 0
NumEntryGuards 6
TORRC
                    /usr/bin/tor -f /fifi-data/torrc >>/fifi-data/tor.log 2>&1 &
                    echo $! > /fifi-data/tor.pid
                    echo "tor: started pid=$(cat /fifi-data/tor.pid)" >> /fifi-data/network.log
                fi
                exit 0
            fi
        done
        sleep 1
    done
    echo "no carrier after 30s" > /fifi-data/network.log
) &

# ── WiFi auto-connect via iwd ─────────────────────────────────────────────────
# Runs in parallel with ethernet negotiation. Reads /fifi-data/wifi.conf:
#   SSID=YourNetworkName
#   PASSWORD=YourPassword
(
    if [ ! -f /fifi-data/wifi.conf ] || [ ! -x /usr/lib/iwd/iwd ]; then
        exit 0
    fi
    # Parse wifi.conf
    WIFI_SSID="" WIFI_PASS=""
    while IFS='=' read -r k v; do
        case "$k" in
            SSID)     WIFI_SSID="$v" ;;
            PASSWORD) WIFI_PASS="$v" ;;
        esac
    done < /fifi-data/wifi.conf
    [ -z "$WIFI_SSID" ] && exit 0

    # Wait for WiFi interface to appear (firmware load takes a moment)
    WIFI_IF=""
    for i in $(seq 1 10); do
        for iface in $(ls /sys/class/net/ 2>/dev/null); do
            [ -d "/sys/class/net/$iface/wireless" ] && WIFI_IF="$iface" && break 2
        done
        sleep 1
    done
    [ -z "$WIFI_IF" ] && echo "wifi: no wireless interface found" >> /fifi-data/network.log && exit 0
    echo "wifi: found interface $WIFI_IF" >> /fifi-data/network.log

    # Set up iwd network profile
    mkdir -p /var/lib/iwd /etc/iwd
    printf '[Security]\nPassphrase=%s\n' "$WIFI_PASS" > "/var/lib/iwd/${WIFI_SSID}.psk"
    # iwd main.conf: use its built-in DHCP client
    cat > /etc/iwd/main.conf << 'IWDCONF'
[General]
EnableNetworkConfiguration=true

[Network]
EnableIPv6=false
NameResolvingService=none
IWDCONF

    # Start iwd (it will auto-connect to the saved profile)
    /usr/lib/iwd/iwd > /fifi-data/wifi.log 2>&1 &
    echo $! > /fifi-data/wifi.pid
    echo "wifi: iwd started, connecting to $WIFI_SSID..." >> /fifi-data/network.log

    # Wait up to 30s for an IP on the WiFi interface
    for i in $(seq 1 30); do
        sleep 1
        WIFI_IP=$(ip -4 addr show "$WIFI_IF" 2>/dev/null | grep "inet " | awk '{print $2}' | cut -d/ -f1)
        if [ -n "$WIFI_IP" ]; then
            echo "wifi: connected to $WIFI_SSID ip=$WIFI_IP" >> /fifi-data/network.log
            echo "$WIFI_SSID" > /fifi-data/wifi-ssid
            echo "connected" > /fifi-data/wifi-status
            # Set DNS if not already set by ethernet or DoH
            if ! grep -q "nameserver" /etc/resolv.conf 2>/dev/null; then
                echo "nameserver 8.8.8.8" > /etc/resolv.conf
            fi
            exit 0
        fi
    done
    echo "wifi: timeout connecting to $WIFI_SSID" >> /fifi-data/network.log
    echo "disconnected" > /fifi-data/wifi-status
) &

# ── DEV DEBUG ONLY — stream logs to dev machine — REMOVE BEFORE DISTRIBUTION ─
# Sends a snapshot of dmesg + compositor.log to 10.0.0.65:9999 every 10s.
# On dev machine run: ~/tools/fifi-watch.sh
(
    sleep 10
    while true; do
        {
            dmesg
            echo '=== input-devices ==='
            cat /fifi-data/input-devices.txt 2>/dev/null
            echo '=== compositor.log ==='
            cat /fifi-data/compositor.log 2>/dev/null
            echo '=== END ==='
        } | nc -w 5 10.0.0.65 9999 2>/dev/null
        sleep 10
    done
) &
# Telnet shell on port 2323 for interactive remote access (same — REMOVE BEFORE DISTRIBUTION)
busybox telnetd -l /bin/sh -p 2323 2>/dev/null &
# ── END DEV DEBUG ─────────────────────────────────────────────────────────────

# ── AppArmor — load profiles in complain mode ────────────────────────────────
if [ -x /usr/bin/apparmor_parser ] && [ -d /etc/apparmor.d ]; then
    # Mount securityfs so AppArmor can load profiles
    mount -t securityfs securityfs /sys/kernel/security 2>/dev/null || true
    # Load all profiles in complain mode (logs violations, doesn't block)
    for profile in /etc/apparmor.d/fifi-*; do
        [ -f "$profile" ] && /usr/bin/apparmor_parser -C "$profile" 2>>/fifi-data/apparmor.log || true
    done
    echo "apparmor: profiles loaded (complain mode)" > /fifi-data/apparmor-status
else
    echo "apparmor: not available (kernel support required)" > /fifi-data/apparmor-status
fi

# ── Phase 5: Firewall — apply nftables default-deny inbound rules ─────────────
mkdir -p /fifi-data
if [ -x /usr/sbin/nft ] && [ -f /etc/nftables.conf ]; then
    /usr/sbin/nft -f /etc/nftables.conf 2>/fifi-data/firewall.log && \
        echo "firewall: active" >> /fifi-data/firewall.log || \
        echo "firewall: failed (kernel nftables support required)" >> /fifi-data/firewall.log
else
    echo "firewall: nft or rules not found" > /fifi-data/firewall.log
fi

# ── PipeWire audio daemon (multi-app mixing, PulseAudio-compatible) ──────────
mkdir -p /tmp/pulse
if [ -x /usr/bin/pipewire ]; then
    /usr/bin/pipewire -c /usr/share/pipewire/fifi.conf >/fifi-data/pipewire.log 2>&1 &
    sleep 1
    [ -x /usr/bin/pipewire-pulse ] && \
        /usr/bin/pipewire-pulse >/fifi-data/pipewire-pulse.log 2>&1 &
fi

# ── XWayland (enables X11 apps: Steam, browsers, legacy software) ─────────────
# Starts after compositor brings up wayland-0; sleep provides a small window.
# The compositor sets WAYLAND_DISPLAY=wayland-0 and XDG_RUNTIME_DIR=/tmp.
if [ -x /usr/bin/Xwayland ]; then
    (
        # Wait up to 10s for wayland-0 socket to appear
        for i in $(seq 1 20); do
            [ -S /tmp/wayland-0 ] && break
            sleep 0.5
        done
        /usr/bin/Xwayland :0 -rootless -terminate \
            >/fifi-data/xwayland.log 2>&1
    ) &
fi

# ── Launch FiFi compositor ────────────────────────────────────────────────────
# Prevent glibc IFUNC from selecting AVX-512 paths — fifi kernel may not
# fully initialise ZMM XSAVE state, causing SIGILL on zmm instructions.
export GLIBC_TUNABLES="glibc.cpu.hwcaps=-AVX512F,-AVX512VL,-AVX512BW,-AVX512CD,-AVX512DQ,-AVX512IFMA,-AVX512VBMI"
if [ -x /bin/fifi-compositor ]; then
    exec /bin/fifi-compositor 2>/fifi-data/compositor.log
fi

# Fallback: shell if compositor not present
if [ -x /bin/ush ]; then
    exec /bin/ush
else
    exec /bin/sh
fi

exec /bin/sh
