# AppArmor profile for FiFi compositor — complain mode logs violations without blocking
# Switch to "enforce" in a future release once profiles are tuned.
#include <tunables/global>

/bin/fifi-compositor flags=(complain) {
  #include <abstractions/base>

  # Framebuffer and input devices
  /dev/dri/**        rw,
  /dev/input/**      rw,
  /dev/fb*           rw,

  # Font and data files
  /fifi-data/**      rw,
  /tmp/**            rw,
  /var/run/**        rw,
  /etc/resolv.conf   r,

  # Proc and sys for system info
  /proc/**           r,
  /sys/**            r,

  # IPC socket
  /tmp/fifi-compositor.sock rw,
  /tmp/wayland-*     rw,

  # Spawn child apps
  /bin/fifi-*        ix,
  /usr/bin/steam     ix,
  /usr/bin/Xwayland  ix,
  /usr/bin/pipewire  ix,

  # Network (for network status reading)
  network,
}
