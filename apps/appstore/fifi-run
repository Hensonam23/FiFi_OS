#!/bin/sh
# fifi-run — the single, unified app launcher for FiFi OS.
#
# Every app (App Store downloads, desktop icons, bundled apps) launches through
# here so they all open and run the same way against the shared FiFi runtime
# (/fifi-data/runtime: libs + xkb + fontconfig). AppImages are auto-extracted
# once (no FUSE on the box) and cached next to the .AppImage as <name>.d/.
#
# Usage: fifi-run <path-to-.AppImage | path-to-executable> [args...]
set -e

RT=/fifi-data/runtime
BROWSER=/fifi-data/browser
target="$1"
[ -n "$target" ] || { echo "usage: fifi-run <app> [args...]" >&2; exit 2; }
shift 2>/dev/null || true

# --- shared runtime environment (identical for every app) ---------------------
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export XKB_CONFIG_ROOT="$RT/share/X11/xkb"
export FONTCONFIG_PATH="$RT/etc/fonts"
export XDG_DATA_DIRS="$RT/share:$BROWSER/sysroot/usr/share"
export LD_LIBRARY_PATH="$RT/lib:$BROWSER/squashfs-root:$BROWSER/sysroot/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# no D-Bus / a11y on the box -> disable so toolkits don't hang or crash
export NO_AT_BRIDGE=1 GTK_A11Y=none GNOME_ACCESSIBILITY=0 QT_ACCESSIBILITY=0
export DBUS_SESSION_BUS_ADDRESS=disabled:
# software rendering (no GPU stack on the box yet)
export LIBGL_ALWAYS_SOFTWARE=1
# steer every toolkit to Wayland
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export ELECTRON_DISABLE_SANDBOX=1
# Bitwarden's AppImage wrapper defaults to --ozone-platform=x11 (to dodge an
# Electron 39 Wayland+hardware-accel crash) UNLESS USE_X11=false. On the box we
# render in software, so that crash doesn't apply — and forcing X11 routed
# Bitwarden through XWayland, which opened it full-screen and turned it
# transparent when resized smaller. Opt back into Wayland so it's a normal,
# resizable FiFi window. Harmless to apps that don't read USE_X11.
export USE_X11=false
export APPIMAGE_EXTRACT_AND_RUN=1

# Start a rootful XWayland (:0) on demand for apps that only speak X11 (e.g.
# LibreOffice's "gen" VCL). Rootful = the whole X screen is ONE FiFi window
# (the compositor has no X11 window-manager, so rootless can't map windows).
# The X client libs, libEGL, and xkbcomp live in the persistent runtime; only
# /usr resets each boot, so xkbcomp is re-seeded there (Xwayland execs it by
# absolute path).
# True if a process whose comm matches $1 is running.
proc_running() {
    for _d in /proc/[0-9]*; do
        [ -r "$_d/comm" ] || continue
        read -r _c < "$_d/comm" 2>/dev/null || continue
        [ "$_c" = "$1" ] && return 0
    done
    return 1
}

ensure_xwayland() {
    # hint the compositor with a friendly window title (XWayland reports only
    # "Xwayland on :0"); the compositor relabels its window to this.
    printf '%s' "${APP_NAME:-App}" > /tmp/xwayland-title 2>/dev/null || true
    # Rootful XWayland presents the whole X screen as ONE FiFi window = one app.
    # Reuse the running X server ONLY while an X app (soffice) is still attached
    # to it. An XWayland left alive after its app closed has a stale/black X root
    # that a new app won't repaint into — so tear that orphan down and start a
    # fresh server. (A dead XWayland leaving only a socket is handled the same.)
    if [ -S /tmp/.X11-unix/X0 ] && proc_running Xwayland && proc_running soffice.bin; then
        return 0
    fi
    proc_running Xwayland && { busybox pkill -9 Xwayland 2>/dev/null; sleep 1; }
    rm -f /tmp/.X11-unix/X0 /tmp/.X0-lock 2>/dev/null || true
    # xkbcomp: image ships it at /usr/bin; older boxes only have it in the runtime.
    [ -x /usr/bin/xkbcomp ] || cp "$RT/bin/xkbcomp" /usr/bin/xkbcomp 2>/dev/null || true
    # xkb data: prefer the image copy, fall back to the runtime one.
    xkbdir=/usr/share/X11/xkb
    [ -d "$xkbdir" ] || xkbdir="$RT/share/X11/xkb"
    # windowed (NOT -fullscreen) so the FiFi compositor can decorate it with a
    # titlebar + traffic-lights and the user can move/resize it
    WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    LD_LIBRARY_PATH="$RT/lib" \
        busybox setsid /usr/bin/Xwayland :0 -geometry 1800x1050 \
        -xkbdir "$xkbdir" </dev/null >/tmp/xwayland.log 2>&1 &
    # Wait for the X server to be ready before the app connects. busybox has no
    # `seq`, so the old `$(seq 1 40)` loop expanded to nothing and did NOT wait —
    # the X11 app (soffice) then raced XWayland startup, lost, and exited with
    # "no suitable windowing system found", leaving a black window. Use a plain
    # while loop, then a short grace so the server is actually accepting clients.
    _i=0
    while [ "$_i" -lt 60 ]; do
        [ -S /tmp/.X11-unix/X0 ] && break
        sleep 0.25; _i=$((_i + 1))
    done
    sleep 0.6
}

launch_dir() {
    # $1 = extracted squashfs-root dir. Detect Electron/Chromium and add the
    # flags they need on this box (root -> no sandbox, force wayland+swgl).
    dir="$1"; shift
    # X11-only apps (LibreOffice): no Wayland backend, so run them under a
    # rootful XWayland presented as a single FiFi window.
    if [ -n "$(ls -d "$dir"/program/soffice "$dir"/opt/*/program/soffice 2>/dev/null)" ]; then
        ensure_xwayland
        export DISPLAY=:0
        export SAL_USE_VCLPLUGIN=gen           # raw-X11 VCL (no GTK/Wayland)
        unset GDK_BACKEND QT_QPA_PLATFORM       # don't steer it to Wayland
        export APPDIR="$dir"; cd "$dir"
        [ -x "$dir/AppRun" ] && exec "$dir/AppRun" "$@"
    fi
    # Archimage/JuNest packages (ivan-hc builds) run a containerized Arch inside
    # proot and refuse to start as root. Give them a fake non-root identity via
    # an unprivileged user namespace, a persistent bound home, and a clean env
    # (the container is self-sufficient; FiFi runtime paths would dangle inside).
    if [ -d "$dir/.local/share/junest" ]; then
        chmod 0666 "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" 2>/dev/null || true
        mkdir -p /fifi-data/home /home/fifi 2>/dev/null || true
        chmod 0777 /fifi-data/home /home/fifi 2>/dev/null || true
        mountpoint -q /home/fifi 2>/dev/null || \
            mount --bind /fifi-data/home /home/fifi 2>/dev/null || true
        unset XDG_DATA_DIRS FONTCONFIG_PATH XKB_CONFIG_ROOT LD_LIBRARY_PATH
        export HOME=/home/fifi USER=fifi LOGNAME=fifi
        exec busybox unshare -U -- "$dir/AppRun" "$@"
    fi
    export LD_LIBRARY_PATH="$dir:$LD_LIBRARY_PATH"
    # Firefox/LibreWolf refuse to run as root ONLY when $HOME is owned by a
    # different uid — and /root here belongs to the image-builder uid. Point HOME
    # at the root-owned persistent /fifi-data/home so the check passes (no need to
    # drop privileges), and disable the content sandbox whose nested user-namespace
    # clone is blocked on this box. Runtime xkb/fontconfig/libs are read fine as root.
    if [ -e "$dir/librewolf-bin" ] || [ -e "$dir/librewolf" ] || \
       [ -e "$dir/firefox-bin" ]  || [ -e "$dir/firefox" ]; then
        mkdir -p /fifi-data/home 2>/dev/null || true
        export HOME=/fifi-data/home
        export MOZ_DISABLE_CONTENT_SANDBOX=1
        # Dedicated persistent profile next to the app, created up front so the
        # first run initializes it in place (an empty -profile dir shows "Profile
        # Missing"; a non-existent one too). --no-remote so it never forwards to
        # a stale instance/lock and silently exit.
        prof="$(dirname "$dir")/profile"
        mkdir -p "$prof" 2>/dev/null || true
        export APPDIR="$dir"; cd "$dir"
        exec "$dir/AppRun" --no-remote -profile "$prof" "$@"
    fi
    if [ -f "$dir/chrome-sandbox" ] || ls "$dir"/resources/*.asar >/dev/null 2>&1; then
        set -- --no-sandbox --ozone-platform=wayland --disable-gpu --in-process-gpu "$@"
    fi
    if [ -x "$dir/AppRun" ]; then export APPDIR="$dir"; cd "$dir"; exec "$dir/AppRun" "$@"; fi
    # fallback: an executable named like the dir's parent
    b=$(ls "$dir" 2>/dev/null | while read f; do [ -x "$dir/$f" ] && [ -f "$dir/$f" ] && echo "$f" && break; done)
    [ -n "$b" ] && exec "$dir/$b" "$@"
    echo "fifi-run: no launchable binary in $dir" >&2; exit 1
}

case "$target" in
    *.AppImage)
        base=$(basename "$target" .AppImage)
        ext="$(dirname "$target")/$base.d"
        if [ ! -d "$ext/squashfs-root" ]; then
            mkdir -p "$ext"
            ( cd "$ext" && "$target" --appimage-extract >/dev/null 2>&1 )
        fi
        export APP_NAME="$base"
        launch_dir "$ext/squashfs-root" "$@"
        ;;
    *)
        exec "$target" "$@"
        ;;
esac
